---
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
const { title = 'No Babysitting', description = SITE.descriptionVi } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
/* Google Fonts strips arrows, ✓, ■ and block characters from its subsets, so each OS drew them in a different fallback
   font. JetBrains Mono's own glyphs for them (5 KB, SIL OFL 1.1: THIRD_PARTY_NOTICES.md) are added to every text face.
   A face joins the Google ones only with the exact same family, style and weight, hence one rule per face below. */
const SYMBOLS = 'U+2190-21FF,U+221E,U+2248,U+2260-2265,U+2500-25FF,U+2713,U+2717,U+27E8-27E9';
const LOADED: Record<string, [string, number][]> = { /* exactly what the Google Fonts link requests */
  'JetBrains Mono': [['normal', 400], ['normal', 500], ['normal', 600], ['italic', 400], ['italic', 600]],
  'Be Vietnam Pro': [['normal', 400], ['normal', 500], ['normal', 600], ['italic', 400]],
  Newsreader: [['normal', 400], ['normal', 500], ['italic', 400]],
};
const symbolsCss = Object.entries(LOADED).flatMap(([f, vs]) => vs.map(([st, w]) =>
  `@font-face{font-family:'${f}';font-style:${st};font-weight:${w};src:url('${url('fonts/jetbrains-mono-symbols.woff2')}') format('woff2');font-display:swap;unicode-range:${SYMBOLS}}`)).join('');
---
<!doctype html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#14120f" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${SITE.name} · ${SITE.descriptor}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="vi_VN" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- real italics (ital axis): without them the browser slants the upright face (docs/11-typography.md) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
  <style is:inline set:html={symbolsCss}></style>
  <link rel="stylesheet" href={url('ds/tokens.css')} />
  <link rel="stylesheet" href={url('ds/bundle.css')} />
  <script is:inline>
    /* motion mode before first paint. Off when the OS asks for reduced motion or the visitor switched it off
       in the HUD (localStorage 'nb-motion'); falls back to static if the motion core never reports in */
    (function () {
      var off = false; try { off = localStorage.getItem('nb-motion') === 'off'; } catch (e) { /* storage blocked */ }
      if (off || matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('motion-off'); return; }
      document.documentElement.classList.add('motion');
      setTimeout(function () { if (!window.gsap) document.documentElement.classList.remove('motion'); }, 4000);
    })();
  </script>
  <script is:inline src={url('ds/bundle.js')}></script>
  {SITE.goatcounter && <script is:inline async data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  <style is:global>
    :root { color-scheme: dark; } :root[data-theme='light'] { color-scheme: light; }
    html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-text); }
    .wrap { max-width: var(--page-max); margin: 0 auto; padding-inline: max(16px, env(safe-area-inset-left, 0px)); }
    html.motion:not(.motion-ready) [data-reveal='up'] { opacity: 0; }
    html.motion:not(.motion-ready) [data-reveal='rule'] { visibility: hidden; }
    .nb-split { display: block; }
    .skip { position: absolute; left: 12px; top: 8px; z-index: 100; padding: 10px 14px; background: var(--fg); color: var(--bg); font: 600 13px/1.2 var(--font-mono); letter-spacing: .04em; text-decoration: none; transform: translateY(-200%); }
    .skip:focus { transform: none; }
    main:focus { outline: none; }
    html.lenis, html.lenis body { height: auto; }
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
    .lenis.lenis-stopped { overflow: hidden; }
    ::selection { background: var(--fg); color: var(--bg); }
    /* the terminal cursor: on for half a period, nearly off for the other half, no easing. Only ever applied under html.motion. */
    @keyframes nb-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: .08; } }
  </style>
</head>
<body class="nb"><a class="skip" href="#main">Bỏ qua tới nội dung</a><slot />
<SiteFooter title={title} />
<script>
  import '../scripts/motion';
</script>
</body>
</html>
