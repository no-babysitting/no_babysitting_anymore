---
import Base from '../layouts/Base.astro';
import SurfaceTabs from '../components/SurfaceTabs.astro';
import Hud from '../components/Hud.astro';
import AsciiHero from '../components/ds/AsciiHero.astro';
import { chapters, href, PARTS } from '../lib/chapters';
---
<Base>
  <Hud />
  <div class="wrap herox"><AsciiHero /></div>
  <main class="wrap hero">
    <span class="nb-micro"><span class="nb-sq"></span>Mở đầu · M0 tracer bullet</span>
    <div id="mark"></div>
    <p class="lead">Từ vibe đến agentic, giao việc cho Claude như giao cho một đồng nghiệp giỏi.</p>
    <p><span class="nb-tag is-info">Đang dựng · M0</span></p>
    <p class="go"><a class="nb-btn is-solid" href="/c00/">Bắt đầu · Mở đầu</a> <a class="nb-btn" href="/library/">Library</a></p>
    <section class="toc" aria-labelledby="toc-h">
      <span class="nb-micro" id="toc-h">12 phần · khoảng 118 phút tự học</span>
      <ol>
        {chapters.map((c) => (
          <li><a href={href(c.id)}>
            <span class="no nb-cond">{c.no}</span>
            <span class="meta nb-micro">{PARTS[c.id]}{c.level && c.level !== 'Kết' ? ` · ${c.level.toUpperCase()}` : ''}</span>
            <span class="en">{c.en}</span><span class="vi">{c.vi}</span>
            {c.id === 'c02' ? <span class="nb-tag is-signal">Có simulator S1</span> : <span class="nb-tag is-muted">Khung</span>}
          </a></li>
        ))}
      </ol>
    </section>
    <SurfaceTabs feature="plan-mode" chapter="c03" />
  </main>
</Base>
<style>
  .hero { display: grid; gap: 28px; padding-block: 96px 64px; }
  .lead { margin: 0; font-size: 19px; line-height: 1.5; color: var(--fg-muted); max-width: 52ch; }
  .go { display: flex; gap: 10px; flex-wrap: wrap; margin: 0; }
  .toc { display: grid; gap: 12px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); border-top: 1px solid var(--control); border-left: 1px solid var(--control); }
  .toc a { display: grid; gap: 6px; align-content: start; height: 100%; box-sizing: border-box; padding: 16px; border-right: 1px solid var(--control); border-bottom: 1px solid var(--control); color: var(--fg); text-decoration: none; }
  .toc a:hover { background: var(--bg-raised); }
  .toc .no { font-size: 56px; line-height: .85; }
  .toc .en { font: 600 13px/1.3 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .toc .vi { font-size: 14px; color: var(--fg-muted); }
  .herox { padding-top: 24px; }
</style>
<script>
  const NB = (window as any).NoBabysitting;
  NB.logo(document.getElementById('mark'), { size: 'lg', maxScale: 6 });
</script>
