---
/* Một phần của lộ trình chính v4 (docs/14 §3, §6): Hook → Lõi → Kết.
   Ba điểm dừng: câu hỏi hook, thẻ Then → Now chính, câu chốt (docs/15 §3). Chữ nằm ở src/content/parts.ts.
   Chưa có ở đợt này: 5 hình mở chương (chờ chủ dự án chọn hướng, D38), mascot bên lề (UX4), M15 và M17. */
import Base from '../../layouts/Base.astro';
import Hud from '../../components/Hud.astro';
import PartNav from '../../components/PartNav.astro';
import LensBlock from '../../components/LensBlock.astro';
import { PARTS, SOURCES, SHIFTS, PHASES, LENSES, partOf, type Block } from '../../content/parts';
import { url } from '../../lib/url';
export function getStaticPaths() { return PARTS.map((p) => ({ params: { part: p.id }, props: { p } })); }
const { p } = Astro.props;
const link = (h: string) => h.replace(/data-href="([^"]*)"/g, (_m, x) => `href="${url(x)}"`);
/* nguồn trong câu là nhãn chữ (S1, S3); link bấm được nằm ở danh sách "Nguồn của phần này" cuối trang, nơi ô bấm đủ lớn cho điện thoại */
const refs = (src?: string[]) => (src || []).join(' · ');
const label = p.phase === 'Mở đầu' ? 'Mở đầu' : `${p.phase} · ${p.id}`;
---
<Base title={`${p.vi} · ${p.id} ${p.en} · No Babysitting`} description={p.summary}>
  <Hud current={p.id} />
  <main id="main" tabindex="-1" class="wrap pt">
    <header class="op">
      <p class="nb-cond idx" aria-hidden="true">{p.id}</p>
      <div class="ttl">
        <p class="nb-tag">{label}</p>
        <h1 class="en" lang="en">{p.en}</h1>
        <p class="vi">{p.vi}</p>
        <p class="sum">{p.summary}</p>
        <p class="nb-micro mins">{p.minutes} phút</p>
      </div>
    </header>

    <section class="hook" data-hold="0.6" aria-labelledby="hook-q">
      {p.hook.stat && <p class="stat"><span class="nb-cond n">{p.hook.stat[0]}</span><span class="sl">{p.hook.stat[1]}</span></p>}
      <h2 class="nb-q q" id="hook-q" data-reveal="words">{p.hook.question}</h2>
      {p.hook.bridge && <p class="bridge" data-reveal="up">{p.hook.bridge}</p>}
      {p.hook.src && <p class="ref nb-micro"><a href="#src-h">Nguồn · {refs(p.hook.src)} ↓</a></p>}
    </section>

    <div class="core">
      {p.core.map((b: Block) => {
        if (b.t === 'h') return <h2 class="bh">{b.text}</h2>;
        if (b.t === 'p') return <p class="body"><Fragment set:html={link(b.html)} />{b.src && <span class="ref nb-micro" set:html={' ' + refs(b.src)} />}</p>;
        if (b.t === 'list') { const L = b.ordered ? 'ol' : 'ul'; return <div class="lst"><L class={b.ordered ? 'num' : ''}>{b.items.map((i) => <li set:html={link(i)} />)}</L>{b.src && <p class="ref nb-micro" set:html={'Nguồn · ' + refs(b.src)} />}</div>; }
        if (b.t === 'grid4') return <dl class="g4">{b.cells.map((c) => <div><dt>{c[0]}</dt><dd>{c[1]}</dd></div>)}</dl>;
        if (b.t === 'way') return (
          <section class="way">
            <h3><span class="wn" aria-hidden="true">{b.no}</span>{b.title}</h3>
            <p class="body"><Fragment set:html={b.html} />{b.src && <span class="ref nb-micro" set:html={' ' + refs(b.src)} />}</p>
            <p class="pr"><span class="nb-sr">Prompt mẫu: </span>{b.prompt}</p>
          </section>);
        if (b.t === 'thenNow') return (
          <section class:list={['tn', b.main && 'is-main']} data-hold={b.main ? '0.8' : undefined} aria-label={b.vi || 'Hồi đó và bây giờ'}>
            {b.vi && <header><h2 class="tv">{b.vi}</h2><p class="te" lang="en">{b.en}</p></header>}
            <div class="tg">
              <div class="then"><span class="nb-micro">Hồi đó</span><p><s set:html={b.then} /></p></div>
              <span class="arw" aria-hidden="true">→</span>
              <div class="now"><span class="nb-micro">Bây giờ</span><p set:html={b.now} /></div>
            </div>
            <p class="why"><Fragment set:html={b.why} /><span class="ref nb-micro" set:html={' ' + refs(b.src)} /></p>
          </section>);
        if (b.t === 'note') return <aside class="note"><p class="nb-tag is-warn">{b.tag}</p><p class="body"><Fragment set:html={link(b.html)} />{b.src && <span class="ref nb-micro" set:html={' ' + refs(b.src)} />}</p></aside>;
        if (b.t === 'grill') { const rec = b.options.find((o) => o.rec)!; return (
          <section class="gr" data-grill aria-label="Giả lập: Claude hỏi bạn một câu">
            <p class="nb-tag">Câu 1/3</p>
            <p class="gq">{b.q}</p>
            <div class="go" role="group" aria-label="Lựa chọn">
              {b.options.map((o) => <button type="button" aria-pressed={o.rec ? 'true' : 'false'} data-back={o.back}><span class="o" aria-hidden="true"></span><span>{o.text}</span>{o.rec && <span class="nb-tag is-signal">Đề xuất</span>}</button>)}
            </div>
            <p class="gx"><b>Đề xuất:</b> <span data-grill-back aria-live="polite">{rec.back}</span></p>
            <p class="gx"><b>Vì sao hỏi câu này trước:</b> {b.why}</p>
            <p class="nb-micro">2 câu nữa, hỏi từng câu một</p>
          </section>); }
        if (b.t === 'lens') return <LensBlock title={b.title} intro={b.intro} outro={b.outro} rows={b.rows} chips={b.first} />;
        if (b.t === 'phases') return (
          <ol class="ph">{PHASES.map((f) => <li><span class="nb-micro">{f.label}</span><span class="pl">{f.line}</span><span class="pk">{f.parts.map((id) => <a href={url(id + '/')}>{id} · {partOf(id).vi}</a>)}</span></li>)}</ol>);
        if (b.t === 'shifts') return (
          <div class="sh">
            <ol>{SHIFTS.map((s) => <li><span class="sv">{s.vi}</span><span class="se" lang="en">{s.en}</span><a class="nb-micro" href={url(s.part + '/')}>Phần {s.part}</a></li>)}</ol>
            <p class="body">Nhóm làm Claude Code đã đưa các thực hành này vào <code>/doctor</code>, để tự rà và tỉa skill và <code>CLAUDE.md</code> của bạn.<span class="ref nb-micro" set:html={' ' + refs(['S1'])} /></p>
          </div>);
      })}
    </div>

    <section class="close" aria-labelledby="close-h">
      <h2 class="nb-sr" id="close-h">Câu chốt và prompt mang đi thử</h2>
      <div class="cl" data-hold="0.6"><p class="line" data-reveal="fill" set:html={p.close.line} /></div>
      {p.close.src && <p class="ref nb-micro" set:html={'Nguồn · ' + refs(p.close.src)} />}
      {p.close.after && <p class="body">{p.close.after}</p>}
      <div class="take" data-lens-group>
        <p class="nb-micro"><span class="nb-sq"></span>Prompt mang đi thử</p>
        {LENSES.map((l) => <p class="pr" data-lens-id={l.id} hidden={l.id !== 'chung'}>{p.close.prompt[l.id]}</p>)}
        <button class="nb-btn" type="button" data-copy>Chép</button>
        <span class="nb-micro" data-copied aria-live="polite"></span>
      </div>
    </section>

    <section class="srcs" id="src-h-sec" aria-labelledby="src-h">
      <h2 class="nb-micro" id="src-h">Nguồn của phần này</h2>
      <ul>{p.sources.map((s) => <li id={`src-${s}`}><span class="nb-micro">{s}</span><a href={SOURCES[s].href} target="_blank" rel="noopener">{SOURCES[s].label} ↗</a></li>)}</ul>
    </section>

    <PartNav current={p.id} />
  </main>
</Base>

<style>
  .pt { display: grid; gap: var(--space-8); padding-block: 16px 96px; grid-template-columns: minmax(0, 1fr); }
  .op { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 28px; align-items: end; border-bottom: 1px solid var(--control); padding-bottom: 28px; overflow: hidden; }
  .idx { margin: 0 0 -0.08em; font-size: clamp(120px, 20vw, 280px); color: var(--fg); }
  .ttl { display: grid; gap: 12px; padding-bottom: 6px; }
  .ttl p { margin: 0; }
  .en { margin: 0; font-family: var(--font-wide); font-stretch: 125%; font-weight: 800; letter-spacing: -.012em; line-height: .96; font-size: clamp(28px, 4.6vw, 64px); overflow-wrap: anywhere; }
  .vi { font-weight: 500; font-size: clamp(19px, 1.6vw, 21px); }
  .sum { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.55; color: var(--fg-muted); max-width: var(--measure); }

  .hook { display: grid; gap: 20px; align-content: center; padding-block: clamp(36px, 9svh, 88px); }
  .stat { margin: 0; display: grid; gap: 10px; }
  .stat .n { font-size: clamp(96px, 16vw, 200px); color: var(--fg); }
  .stat .sl { font-size: 17px; line-height: 1.55; color: var(--fg-muted); max-width: var(--measure); }
  .q { margin: 0; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.2; max-width: 24ch; text-wrap: balance; }
  .bridge { margin: 0; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.55; color: var(--fg-muted); max-width: var(--measure); }

  .core { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
  .core > * { margin: 0; }
  .bh { font: 500 clamp(24px, 3vw, 34px)/1.22 var(--font-display); max-width: 26ch; margin-top: 36px; text-wrap: balance; }
  .core > .bh:first-child { margin-top: 0; }
  .pt :global(.body) { margin: 0; font-size: 17px; line-height: 1.65; max-width: var(--measure); }
  .pt :global(code) { font: 500 .9em var(--font-mono); background: var(--bg-sunken); border: 1px solid var(--control); padding: 1px 5px; }
  .pt :global(b) { font-weight: 600; }
  .pt :global(em[lang]) { font-style: italic; }
  .pt :global(q) { font-family: var(--font-display); font-style: italic; quotes: '“' '”'; }
  .pt :global(.body a), .srcs a { color: var(--fg); text-underline-offset: 3px; }
  /* golden word (docs/15 §2): 600 from the start, an underline set below the Vietnamese dot-below marks */
  .pt :global(.nb-gold) { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .32em; text-decoration-skip-ink: none; }
  .pt :global(.ref) { color: var(--fg-subtle); white-space: nowrap; }
  .pt :global(.ref a) { color: var(--fg-muted); text-underline-offset: 3px; display: inline-flex; align-items: center; min-height: 44px; }

  .lst { display: grid; gap: 8px; }
  .lst ul, .lst ol { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; font-size: 17px; line-height: 1.6; max-width: var(--measure); }
  .g4 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--control); max-width: 860px; }
  .g4 > div { padding: 18px; display: grid; gap: 6px; align-content: start; border-bottom: 1px solid var(--control); }
  .g4 > div:nth-child(odd) { border-right: 1px solid var(--control); }
  .g4 > div:nth-last-child(-n + 2) { border-bottom: 0; }
  .g4 dt { font-weight: 600; font-size: 17px; }
  .g4 dd { margin: 0; font-size: 16px; line-height: 1.55; color: var(--fg-muted); }

  .way { display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: 20px; }
  .way h3 { margin: 0; font: 600 19px/1.4 var(--font-text); max-width: 34ch; display: grid; grid-template-columns: auto 1fr; gap: 12px; }
  .wn { font: 600 13px/2 var(--font-mono); color: var(--fg-muted); }
  .pt :global(.pr) { margin: 0; font: 500 clamp(16px, 1.3vw, 18px)/1.55 var(--font-mono); background: var(--bg-raised); border: 1px solid var(--control); padding: 14px 16px; max-width: 62ch; overflow-wrap: anywhere; }

  .tn { display: grid; gap: 18px; border: 1px solid var(--control); padding: clamp(18px, 3vw, 32px); margin-top: 20px; background: var(--bg); }
  .tn header { display: grid; gap: 6px; }
  .tv { margin: 0; font: 600 clamp(21px, 2vw, 24px)/1.25 var(--font-text); }
  .te { margin: 0; font: 400 13px/1.4 var(--font-mono); color: var(--fg-muted); }
  .tg { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 20px; align-items: start; }
  .tg > div { display: grid; gap: 8px; }
  .tg p { margin: 0; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.5; }
  .then p { color: var(--fg-muted); }
  .then s { text-decoration-thickness: 1px; }
  .now p { font-weight: 500; }
  .arw { font: 600 20px/1.6 var(--font-mono); color: var(--fg-muted); padding-top: 22px; }
  .why { margin: 0; font-size: 16px; line-height: 1.6; color: var(--fg-muted); max-width: 62ch; border-top: 1px solid var(--line); padding-top: 14px; }

  .note { display: grid; gap: 8px; border-left: 2px solid var(--control); padding: 4px 0 4px 16px; }
  .note p { margin: 0; }
  .note .nb-tag { white-space: normal; }

  .gr { display: grid; gap: 12px; border: 1px solid var(--control); background: var(--bg-raised); padding: clamp(16px, 2.4vw, 24px); max-width: 720px; }
  .gr p { margin: 0; }
  .gq { font: 600 clamp(17px, 1.5vw, 19px)/1.4 var(--font-text); }
  .go { display: grid; }
  .go button { appearance: none; background: transparent; border: 0; border-top: 1px solid var(--line); color: var(--fg); font: 400 16px/1.45 var(--font-text); text-align: left; padding: 10px 4px; min-height: 44px; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; cursor: pointer; }
  .go button:hover { background: var(--bg); }
  .go button:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
  .go .o { flex: none; width: 12px; height: 12px; border: 1.5px solid var(--control); border-radius: 50%; box-sizing: border-box; }
  .go button[aria-pressed='true'] .o { background: var(--fg); border-color: var(--fg); }
  .gx { font-size: 15px; line-height: 1.55; color: var(--fg-muted); max-width: 60ch; }
  .gx b { color: var(--fg); }

  .ph { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--control); max-width: 860px; }
  .ph li { display: grid; grid-template-columns: 8ch minmax(0, 1fr); gap: 4px 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .ph .pl { font-size: 17px; line-height: 1.5; }
  .ph .pk { grid-column: 2; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .ph a, .sh a { color: var(--fg); text-underline-offset: 3px; font-size: 14px; display: inline-flex; align-items: center; min-height: 44px; }
  .sh { display: grid; gap: 16px; }
  .sh ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--control); max-width: 860px; counter-reset: sh; }
  .sh li { counter-increment: sh; display: grid; grid-template-columns: 3ch minmax(0, 1fr) auto; gap: 2px 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .sh li::before { content: counter(sh); font: 600 13px/1.4 var(--font-mono); color: var(--fg-muted); grid-row: 1 / 3; }
  .sv { font-weight: 600; font-size: 17px; }
  .se { grid-column: 2; font: 400 13px/1.4 var(--font-mono); color: var(--fg-muted); }
  .sh li a { grid-column: 3; grid-row: 1 / 3; color: var(--fg); }

  .close { display: grid; gap: 20px; border-top: 1px solid var(--control); padding-top: var(--space-7); grid-template-columns: minmax(0, 1fr); }
  .cl { padding-block: clamp(20px, 5svh, 48px); }
  .line { margin: 0; font: 500 clamp(22px, 2.6vw, 34px)/1.35 var(--font-text); max-width: 30ch; text-wrap: balance; }
  .take { display: grid; gap: 12px; justify-items: start; }
  .take p { margin: 0; }
  .take .nb-btn { min-height: 44px; }
  .srcs { display: grid; gap: 10px; }
  .srcs h2 { margin: 0; }
  .srcs ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .srcs li { display: grid; grid-template-columns: 4ch minmax(0, 1fr); gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--line); align-items: center; scroll-margin-top: 72px; }
  .srcs a { font-size: 15px; line-height: 1.5; display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }

  @media (max-width: 640px) {
    .op { grid-template-columns: 1fr; gap: 8px; }
    .idx { font-size: 120px; }
    .g4 { grid-template-columns: 1fr; }
    .g4 > div:nth-child(odd) { border-right: 0; }
    .g4 > div:nth-last-child(2) { border-bottom: 1px solid var(--control); }
    .tg { grid-template-columns: 1fr; gap: 12px; }
    .arw { padding: 0; transform: rotate(90deg); justify-self: start; line-height: 1; }
    .ph li { grid-template-columns: 1fr; } .ph .pk { grid-column: 1; }
    .sh li { grid-template-columns: 3ch minmax(0, 1fr); } .sh li a { grid-column: 2; grid-row: auto; }
  }
</style>

<script>
  /* giả lập grill me (docs/15 §11): bấm một lựa chọn để xem dòng giải thích đổi theo. Không lưu, không chấm. */
  document.querySelectorAll<HTMLElement>('[data-grill]').forEach((g) => {
    const out = g.querySelector<HTMLElement>('[data-grill-back]')!, bs = g.querySelectorAll<HTMLButtonElement>('button[data-back]');
    bs.forEach((b) => b.addEventListener('click', () => { bs.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); out.textContent = b.dataset.back!; }));
  });
  /* nút Chép: chép đúng prompt của kính đang hiện */
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const box = b.closest('.take')!, t = box.querySelector<HTMLElement>('.pr:not([hidden])')!.textContent || '', say = box.querySelector<HTMLElement>('[data-copied]')!;
    try { await navigator.clipboard.writeText(t.trim()); say.textContent = 'Đã chép'; } catch (e) { say.textContent = 'Không chép được, hãy bôi đen rồi chép'; }
    setTimeout(() => { say.textContent = ''; }, 2400);
  }));
</script>
