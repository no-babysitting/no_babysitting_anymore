---
/* Chapter skeleton generated from the script (chapters.json). c02 has its own full page. */
import Base from '../../layouts/Base.astro';
import Hud from '../../components/Hud.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import ChapterOpener from '../../components/ds/ChapterOpener.astro';
import ChapterMotion from '../../components/ChapterMotion.astro';
import AgentWindow from '../../components/ds/AgentWindow.astro';
import FloatingOps from '../../components/ds/FloatingOps.astro';
import StatusBoard from '../../components/ds/StatusBoard.astro';
import TheColleague from '../../components/ds/TheColleague.astro';
import ThenNowCard from '../../components/ds/ThenNowCard.astro';
import CinematicAscii from '../../components/ds/CinematicAscii.astro';
import TwoFlips from '../../components/scenes/TwoFlips.astro';
import { openerProps } from '../../lib/opener';
import { chapters, PARTS } from '../../lib/chapters';
import { inline } from '../../lib/matrix';
import { bindLast } from '../../lib/typo';
export function getStaticPaths() {
  return chapters.filter((c) => c.id !== 'c02').map((c) => ({ params: { ch: c.id }, props: { c } }));
}
const { c } = Astro.props;
const mins = c.minutes.split('/')[0].replace("'", ' phút');
const short = (s: string) => { const t = s.replace(/[*`]/g, ''); return t.length > 150 ? t.slice(0, 150).replace(/\s+\S*$/, '') + '…' : t; };
---
<Base title={`${c.no} · ${c.en} · No Babysitting`}>
  <Hud current={c.id} />
  <main class="wrap ch">
    <div data-ch-opener><ChapterOpener {...openerProps(c)} /></div>

    <section class="beat ask" data-ask aria-labelledby="q"><span class="nb-micro" data-reveal="up">b1 · hỏi</span><h2 class="nb-q q" id="q" data-reveal="words" set:html={inline(bindLast(c.question))}></h2><span class="nb-micro cue" data-reveal="up">Trả lời trong đầu trước khi cuộn · không có đáp án sai</span></section>

    <section class="facts">
      {c.goals && <div><span class="nb-micro" data-reveal="up">Mục tiêu</span><p data-reveal="lines" set:html={inline(c.goals)} /></div>}
      {c.myth && <div><span class="nb-micro" data-reveal="up">Hiểu lầm → sự thật</span><p data-reveal="lines" set:html={inline(c.myth)} /></div>}
    </section>

    <section class="beats" aria-labelledby="bh">
      <div class="bhd"><span class="nb-micro" id="bh">Các beat · từ kịch bản</span><span class="nb-tag is-info">Khung · nội dung chưa viết</span></div>
      <div class="bwrap">
      <ol class="prog" data-beat-prog aria-hidden="true">{c.beats.map((b) => <li>{b.id}</li>)}</ol>
      <ol data-beats>
        {c.beats.map((b) => (
          <li data-reveal="up"><details>
            <summary><span class="bid">{b.id}</span><span class="ph">{b.phase.toLowerCase()}</span><span class="tx">{short(b.text)}</span></summary>
            <p set:html={inline(b.text)} />
          </details></li>
        ))}
      </ol>
      </div>
      {c.sources && <p class="src nb-micro">Nguồn trong kịch bản · <span set:html={inline(c.sources)} /></p>}
    </section>

    {c.id === 'c00' && <>
      <TwoFlips />
      <section class="scene" data-reveal="up"><span class="nb-micro">Lần tung thứ hai · agentic: Claude làm việc trong harness</span><AgentWindow /></section>
      <section class="scene" data-reveal="up"><span class="nb-micro">Hệ thống đang vận hành · báo cáo tuần W45</span><FloatingOps /></section>
      <section class="scene" data-reveal="up"><span class="nb-micro">Báo cáo tuần · 4 tiêu chí mà 11 chương sẽ mở khoá</span><StatusBoard /></section>
    </>}
    {c.id === 'c01' && <section class="scene" data-reveal="up"><span class="nb-micro">Gặp đồng nghiệp mới</span><TheColleague /></section>}
    {c.id === 'c10' && <>
      <section class="scene" data-reveal="up"><span class="nb-micro">Six shifts · hồi đó → bây giờ</span><ThenNowCard /></section>
      <section class="scene" data-reveal="up"><span class="nb-micro">Finale</span><CinematicAscii /></section>
    </>}

    <ChapterNav current={c.id} />
    <ChapterMotion />
  </main>
</Base>
<style>
  .ch { display: grid; gap: var(--space-8); padding-block: 16px 96px; }
  .opener { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: end; border-bottom: 1px solid var(--control); padding-bottom: 24px; overflow: hidden; }
  .idx { margin: 0; font-size: clamp(120px, 20vw, 280px); color: var(--fg); }
  .name { margin: 8px 0 10px; font-size: clamp(28px, 5vw, 60px); }
  .sub { margin: 0; color: var(--fg-muted); font-size: 17px; max-width: 44ch; }
  .beat { display: grid; gap: 16px; }
  .ask { min-height: calc(100svh - var(--hud-height) - 64px); align-content: center; gap: 22px; }
  .ask .q { font-size: clamp(34px, 5.6vw, 72px) !important; max-width: 20ch !important; }
  .cue { color: var(--fg-subtle); }
  .bwrap { display: grid; grid-template-columns: 52px 1fr; gap: 0 18px; }
  .beats .prog { border-top: 0; list-style: none; margin: 0; padding: 0; position: sticky; top: 72px; align-self: start; display: grid; gap: 6px; }
  .beats .prog li { border-bottom: 0; font: 600 12px/1 var(--font-mono); color: var(--fg-subtle); padding: 4px 0 4px 10px; border-left: 2px solid var(--control); transition: color .24s, border-color .24s; }
  .beats .prog li.on { color: var(--fg-muted); border-color: var(--fg-muted); }
  .beats .prog li.cur { color: var(--fg); border-color: var(--accent); border-left-width: 4px; padding-left: 8px; background: var(--bg-raised); }
  .scene { display: grid; gap: 12px; }
  .q { margin: 0; font-size: clamp(28px, 4vw, 52px); max-width: 26ch; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid var(--control); }
  .facts > div { padding: 18px 18px 18px 0; display: grid; gap: 8px; align-content: start; }
  .facts > div + div { border-left: 1px solid var(--control); padding-left: 18px; }
  .facts p { margin: 0; line-height: 1.6; max-width: var(--measure); }
  .beats { display: grid; gap: 12px; }
  .bhd { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .beats ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--control); }
  .beats li { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 4ch 11ch 1fr; gap: 12px; padding: 12px 4px; align-items: baseline; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--bg-raised); }
  .bid { font: 600 12px/1.4 var(--font-mono); color: var(--fg-subtle); }
  .ph { font: 600 12px/1.4 var(--font-mono); color: var(--fg-muted); }
  .tx { line-height: 1.5; }
  details[open] summary .tx { color: var(--fg-muted); }
  /* ch is the width of "0": Be Vietnam Pro sets about 1.4 Vietnamese characters per ch, so 48ch of text ≈ 66 characters */
  details p { margin: 0; padding: 0 4px 16px calc(15ch + 24px); line-height: 1.65; max-width: calc(15ch + 24px + 48ch); }
  .beats :global(code) { font: 500 max(12px, .9em) var(--font-mono); background: var(--bg-sunken); border: 1px solid var(--control); padding: 1px 4px; }
  .src { color: var(--fg-subtle); line-height: 1.6; max-width: var(--measure); }
  @media (max-width: 640px) {
    .opener, .facts { grid-template-columns: 1fr; }
    .facts > div + div { border-left: 0; padding-left: 0; border-top: 1px solid var(--control); }
    summary { grid-template-columns: 4ch 1fr; } .tx { grid-column: 1 / -1; }
    .bwrap { grid-template-columns: 1fr; } .beats .prog { display: none; }
    details p { padding-left: 4px; }
  }
</style>
