---
/* Các trang khung của kịch bản v3 (c00, c01, c03…c10). Lộ trình chính nay là 5 phần (docs/14 §9):
   link cũ không gãy, trang chỉ báo đang viết lại và dẫn về lộ trình chính; noindex, không có trong menu và sitemap. */
import Base from '../../layouts/Base.astro';
import Hud from '../../components/Hud.astro';
import { chapters } from '../../lib/chapters';
import { PARTS } from '../../content/parts';
import { url } from '../../lib/url';
export function getStaticPaths() {
  return chapters.filter((c) => c.id !== 'c02').map((c) => ({ params: { ch: c.id }, props: { c } }));
}
const { c } = Astro.props;
---
<Base title={`${c.vi} · đang viết lại · No Babysitting`} noindex>
  <Hud />
  <main id="main" tabindex="-1" class="wrap st">
    <p class="nb-tag is-info">Nâng cao · chưa viết</p>
    <h1 class="nb-q">Phần này đang được viết lại</h1>
    <p class="body">“{c.vi}” thuộc kịch bản cũ. Nội dung của nó sẽ trở lại trong mục Nâng cao. Lộ trình chính hiện có {PARTS.length} phần, đọc trong khoảng 25 phút.</p>
    <p class="go"><a class="nb-btn is-solid" href={url('00/')}>Bắt đầu với 00 →</a><a class="nb-btn" href={url()}>Về trang chủ</a></p>
  </main>
</Base>
<style>
  .st { display: grid; gap: 20px; padding-block: 72px 120px; justify-items: start; }
  .st h1 { margin: 0; font-size: clamp(32px, 5vw, 56px); max-width: 20ch; }
  .body { margin: 0; font-size: 17px; line-height: 1.65; max-width: var(--measure); }
  .st p { margin: 0; }
  .go { display: flex; flex-wrap: wrap; gap: 10px; }
  .go .nb-btn { min-height: 44px; }
</style>
