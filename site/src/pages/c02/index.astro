---
import Base from '../../layouts/Base.astro';
import ContextMeter from '../../components/ContextMeter.astro';
import Hud from '../../components/Hud.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import ChapterOpener from '../../components/ds/ChapterOpener.astro';
import ChapterMotion from '../../components/ChapterMotion.astro';
import { chapters } from '../../lib/chapters';
import { openerProps } from '../../lib/opener';
const c02 = chapters.find((c) => c.id === 'c02')!;
/* c02 · The Briefing Budget. Beats b1–b3 and b4 (part) from docs/02-pedagogical-script.md §02.
   Beat text is quoted from the script; sources per beat are listed under each section. */
---
<Base title="02 · The Briefing Budget · No Babysitting">
  <Hud current="c02" />

  <main class="wrap ch">
    <div data-ch-opener><ChapterOpener {...openerProps(c02)} /></div>

    <section class="beat ask" data-ask id="c02-b1" aria-labelledby="b1q">
      <span class="nb-micro" data-reveal="up">b1 · hỏi</span>
      <h2 class="nb-q q" id="b1q" data-reveal="words">Claude vừa viết hỏng phần phân tích 2 lần. Bạn nhắn "không phải vậy, thử lại". Lần thứ 3 sẽ tốt hơn hay tệ hơn?</h2>
    </section>

    <section class="beat" id="c02-b2" aria-labelledby="b2h">
      <span class="nb-micro" id="b2h">b2 · đoán</span>
      <fieldset class="predict" id="c02-predict" data-reveal="up">
        <legend class="nb-sr">Dự đoán của bạn</legend>
        <label><input type="radio" name="p" value="1" /> <span>Tốt hơn, vì Claude đã có thêm thông tin về điều bạn muốn.</span></label>
        <label><input type="radio" name="p" value="2" /> <span>Như cũ, vì mỗi lần thử Claude đều bắt đầu lại từ đầu phiên.</span></label>
        <label><input type="radio" name="p" value="3" /> <span>Dễ tệ hơn: hai bản hỏng vẫn nằm trong cuộc trò chuyện.</span></label>
      </fieldset>
      <p class="hint" id="c02-hint">Chốt dự đoán để mở mô phỏng bên dưới. Không có đáp án bị chấm sai.</p>
    </section>

    <section class="beat" id="c02-b3" aria-labelledby="b3h">
      <span class="nb-micro" id="b3h">b3 · thấy</span>
      <div class="lock" id="c02-lock">
        <ContextMeter />
        <div class="veil" id="c02-veil"><p class="nb-micro">Chốt dự đoán ở b2 để mở mô phỏng</p><button class="nb-btn" type="button" id="c02-skip">Bỏ qua, xem luôn</button></div>
      </div>
      <p class="hint">Cuộn để chạy phiên làm việc: đọc 12 file, tra 6 trang web, rồi hai lần viết hỏng. Sau đó các nút là của bạn.</p>
    </section>

    <section class="beat" id="c02-b4" aria-labelledby="b4h">
      <span class="nb-micro" data-reveal="up">b4 · hiểu</span>
      <h2 class="h" id="b4h" data-reveal="lines">Context là bộ nhớ làm việc, xoá ở mỗi phiên</h2>
      <p class="body" data-reveal="lines">Thứ ăn context: file đã đọc, kết quả tra web, mô tả công cụ, hướng dẫn dự án. Hầu hết model có cửa sổ 1M token và tự nén, nên hết context hiếm khi là vấn đề. Nhưng mỗi bản hỏng và lời sửa vẫn nằm lại trong hội thoại. <code>/clear</code> giữa các việc không liên quan vẫn đáng làm: hội thoại tập trung cho kết quả tốt hơn và rẻ hơn.</p>
      <p class="src nb-micro">Nguồn · <a href="https://code.claude.com/docs/en/best-practices" target="_blank" rel="noopener">Claude Code docs · Best practices ↗</a></p>
    </section>

    <ChapterNav current="c02" />
    <ChapterMotion />
    <script>
      /* b2 locks the S1 stage (motion.md: lock the animation, never the scroll); b3 is the chapter's big moment:
         scrolling plays the session block by block. Scrolling back replays it from a fresh session. */
      function start(w: any) {
        const gsap = w.gsap, lock = document.getElementById('c02-lock')!, veil = document.getElementById('c02-veil')!;
        let open = false;
        const unlock = () => { if (open) return; open = true; gsap ? gsap.to(veil, { autoAlpha: 0, duration: 0.36, onComplete: () => veil.remove() }) : veil.remove();
          document.getElementById('c02-hint')!.textContent = 'Đã chốt. Cuộn xuống để xem chuyện gì xảy ra.'; };
        document.querySelectorAll('#c02-predict input').forEach((i) => i.addEventListener('change', unlock));
        document.getElementById('c02-skip')!.addEventListener('click', unlock);
        if (!gsap || w.NoBabysitting.reduce()) return;
        const STEPS = ['excel', 'web', 'bad', 'bad'];
        const btn = (a: string) => lock.querySelector<HTMLButtonElement>(`[data-a="${a}"]`)!;
        let shown = 0;
        function play(n: number) {
          if (!open || n === shown) return;
          if (n < shown) { btn('fresh').click(); shown = 0; }
          while (shown < n) btn(STEPS[shown++]).click();
        }
        w.ScrollTrigger.create({ trigger: lock, start: 'top top+=64', end: '+=180%', pin: '#c02-b3', pinSpacing: true,
          onUpdate: (s: any) => play(Math.min(STEPS.length, Math.floor(s.progress * (STEPS.length + 0.6)))) });
      }
      if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
    </script>
  </main>
</Base>

<style>
  .ch { display: grid; gap: var(--space-9); padding-block: 16px 128px; }
  .opener { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: end; border-bottom: 1px solid var(--control); padding-bottom: 24px; overflow: hidden; }
  .idx { margin: 0; font-size: clamp(140px, 22vw, 300px); color: var(--fg); }
  .name { margin: 8px 0 10px; font-size: clamp(30px, 5vw, 64px); }
  .sub { margin: 0; color: var(--fg-muted); font-size: 17px; max-width: 44ch; }
  .beat { display: grid; gap: 16px; max-width: 980px; }
  .ask { min-height: calc(100svh - var(--hud-height) - 64px); align-content: center; gap: 22px; max-width: none; }
  .ask .q { font-size: clamp(34px, 5.6vw, 76px); max-width: 20ch; }
  .lock { position: relative; }
  .veil { position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 14px; background: color-mix(in srgb, var(--bg) 72%, transparent); }
  .veil p { color: var(--fg); margin: 0; }
  .q { margin: 0; font-size: clamp(30px, 4.2vw, 56px); max-width: 24ch; }
  .predict { border: 0; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--control); }
  .predict label { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: baseline; padding: 14px 4px; border-bottom: 1px solid var(--control); cursor: pointer; font-size: 18px; line-height: 1.5; }
  .predict label:has(input:checked) { background: var(--fg); color: var(--bg); }
  .predict input { appearance: none; margin: 0; width: 16px; height: 16px; border: 1.5px solid var(--control); border-radius: 0; display: grid; place-content: center; translate: 0 2px; }
  .predict input::before { content: ''; width: 8px; height: 8px; background: var(--bg); transform: scale(0); transition: transform .12s; }
  .predict input:checked { border-color: var(--bg); }
  .predict input:checked::before { transform: scale(1); }
  .predict input:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .hint { margin: 0; color: var(--fg-subtle); font-size: 14px; }
  .h { margin: 0; font: 500 clamp(24px, 3vw, 34px)/1.22 var(--font-display); }
  .body { margin: 0; font-size: 17px; line-height: 1.65; max-width: 66ch; }
  .body code { font: 500 .9em var(--font-mono); background: var(--bg-sunken); border: 1px solid var(--control); padding: 1px 5px; }
  .src a { color: var(--fg); }
  @media (max-width: 640px) {
    .predict label { font-size: 16px; padding: 12px 4px; }
    #c02-b3 :global(.cm) { padding: 40px 12px 12px; gap: 10px; }
    #c02-b3 :global(.duo) { grid-template-columns: 1fr 1fr; }
    #c02-b3 :global(.ix + .ix) { padding-left: 10px; border-left: 1px solid var(--control); border-top: 0; }
    #c02-b3 :global(.ix) { padding: 10px 8px 10px 0; gap: 6px; }
    #c02-b3 :global(.num) { font-size: 56px; }
    #c02-b3 :global(.why) { font-size: 12px; min-height: 0; }
    #c02-b3 :global(.far span) { font-size: 10.5px; }
    #c02-b3 :global(.row) { grid-template-columns: 1fr; gap: 6px; }
    #c02-b3 :global(.log) { min-height: 0; font-size: 11.5px; }
    #c02-b3 :global(.log li:not(:last-child)) { display: none; }
    #c02-b3 :global(.btns) { gap: 6px; }
    #c02-b3 :global(.btns .nb-btn) { padding: 7px 8px; font-size: 11.5px; }
    #c02-b3 :global(.foot .src) { display: none; } .opener { grid-template-columns: 1fr; } .ch { gap: var(--space-8); } }
</style>

