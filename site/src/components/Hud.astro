---
/* JourneyHUD (M0 subset): the logo, where you are, the Library link, and two pixel buttons:
   play/pause for the page's motion (FR-09, WCAG 2.2.2) and the menu. The menu opens as a full-screen layer under the header;
   the picture behind its list (a crossed-out stroller) is ASCII art that converges when it opens and dissolves when it closes. */
import { chapters, indexOf, PARTS, href } from '../lib/chapters';
import { url } from '../lib/url';
import { iconSVG, ICONS } from '../lib/icons';
import { isLive } from '../lib/status';
import { SITE } from '../config';
const { current } = Astro.props as { current?: string };
const i = current ? indexOf(current) : -1;
const c = i >= 0 ? chapters[i] : null;
---
<header class="hud">
  <div class="wrap row">
    <a href={url()} class="wm" data-logo aria-label="No babysitting, về trang đầu"></a>
    {c && <span class="nb-micro part">{PARTS[c.id]}{c.level && c.level !== 'Kết' ? ` · ${c.level.toUpperCase()}` : ''}</span>}
    <nav class="links" aria-label="Trang">
      <a class="nb-micro lib" href={url('library/')}>Library</a>
      {c && <span class="nb-micro pos"><b>{c.id}</b> · {i + 1}/{chapters.length}</span>}
      <button class="ib" type="button" data-motion aria-pressed="true" title="Tắt chuyển động của trang">
        <span class="sq"><span class="on" set:html={iconSVG('pause')} /><span class="off" set:html={iconSVG('play')} /></span>
        <span class="nb-sr">Chuyển động</span>
      </button>
      <button class="ib" type="button" data-menu aria-expanded="false" aria-controls="nb-menu" title="Mở menu">
        <span class="sq"><span class="on" set:html={iconSVG('close')} /><span class="off" set:html={iconSVG('menu')} /></span>
        <span class="nb-sr">Menu</span>
      </button>
    </nav>
  </div>
</header>

<div class="menu" id="nb-menu" hidden data-art={JSON.stringify(ICONS.noStroller)}>
  <canvas class="mcv" aria-hidden="true"></canvas>
  <div class="wrap mbody">
    <nav aria-label="Menu">
      <ul class="m-main">
        <li><a href={url()} aria-current={!current ? 'page' : undefined}>Trang chủ</a></li>
        <li><a href={url('library/')}>Library</a></li>
      </ul>
      <p class="nb-micro m-h">Hành trình · {chapters.length} phần</p>
      <ol class="m-ch">
        {chapters.map((ch) => (
          <li><a href={href(ch.id)} aria-current={ch.id === current ? 'page' : undefined}>
            <span class="no">{ch.no}</span><span class="en">{ch.en}</span><span class="vi">{ch.vi}{!isLive(ch.id) && <i> · đang viết</i>}</span>
          </a></li>
        ))}
      </ol>
      <p class="nb-micro m-foot"><a href={SITE.repo}>Mã nguồn</a><a href={`${SITE.repo}/issues/new`}>Góp ý</a><span>Dự án cộng đồng độc lập, không liên kết với Anthropic</span></p>
    </nav>
  </div>
</div>

<style>
  .hud { position: sticky; top: 0; z-index: 30; height: var(--hud-height); border-bottom: 1px solid var(--control); background: var(--bg); }
  .row { height: 100%; display: flex; align-items: center; gap: 24px; }
  .wm { width: 208px; flex: none; color: var(--fg); display: flex; align-items: center; min-height: 44px; }
  .wm :global(svg) { width: 100%; height: auto; display: block; }
  .links { margin-left: auto; display: flex; gap: 6px; align-items: center; }
  .lib { display: inline-flex; align-items: center; height: 44px; padding: 0 10px; color: var(--fg); text-underline-offset: 3px; }
  .pos { padding-right: 10px; }

  /* retro pixel buttons: a 40px square with a 16x16 bitmap drawn at exactly 2x, inside a 44px hit area */
  .ib { appearance: none; background: transparent; border: 0; padding: 2px; width: 44px; height: 44px; color: var(--fg); cursor: pointer; display: grid; place-items: center; }
  .sq { width: 40px; height: 40px; box-sizing: border-box; border: 1px solid var(--control); display: grid; place-items: center; position: relative; transition: background .12s steps(2), color .12s steps(2); }
  .sq > span { grid-area: 1 / 1; display: grid; }
  .sq :global(svg) { width: 32px; height: 32px; display: block; }
  .ib:hover .sq { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .ib:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
  .ib:disabled { cursor: default; opacity: .7; }
  .ib:disabled:hover .sq { background: transparent; color: var(--fg); border-color: var(--control); }
  /* pressed = on: the motion button then shows PAUSE (what a press does); the menu button shows CLOSE while open */
  .ib[aria-pressed='true'] .off, .ib[aria-expanded='true'] .off, .ib[aria-pressed='false'] .on, .ib[aria-expanded='false'] .on { display: none; }

  /* the menu: a layer under the header, scrolls inside itself, page behind it is inert */
  .menu { position: fixed; inset: var(--hud-height) 0 0 0; z-index: 25; background: var(--bg); overflow-y: auto; overscroll-behavior: contain; }
  .menu[hidden] { display: none; }
  .mcv { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .55; }
  @media (min-width: 721px) { .mcv { left: 38%; width: 62%; } }
  @media (max-width: 720px) { .mcv { opacity: .3; } }
  .mbody { position: relative; padding-block: 28px 56px; }
  .menu nav { display: grid; gap: 22px; max-width: 760px; }
  .m-main { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .m-main a { display: block; padding: 6px 0; font: 400 clamp(32px, 6vw, 52px)/1.14 var(--font-display); color: var(--fg); text-decoration: none; }
  .m-main a:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .m-main a, .m-ch a { position: relative; }
  .m-main a[aria-current='page']::before, .m-ch a[aria-current='page']::before { content: ''; position: absolute; left: -14px; top: 0; bottom: 0; width: 3px; background: var(--accent); }
  :global(html.motion) .m-main a[aria-current='page']::before, :global(html.motion) .m-ch a[aria-current='page']::before { animation: nb-blink 1.1s steps(1, end) infinite; }
  .m-h { margin: 0; color: var(--fg-muted); }
  .m-ch { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .m-ch a { display: grid; grid-template-columns: 4ch minmax(0, 1fr); gap: 0 12px; padding: 11px 6px; min-height: 44px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--fg); }
  .m-ch a:hover { background: var(--bg-raised); }
  .m-ch .no { font: 600 13px/1.4 var(--font-mono); color: var(--fg-muted); grid-row: 1 / 3; }
  .m-ch .en { font: 600 13px/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .m-ch .vi { grid-column: 2; font-size: 14px; color: var(--fg-muted); }
  .m-ch .vi i { font-style: normal; color: var(--fg-subtle); }
  .m-foot { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; color: var(--fg-muted); }
  .m-foot a { color: var(--fg); text-underline-offset: 3px; display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 520px) { .row > .part, .pos { display: none; } .wm { width: 156px; } .row { gap: 8px; } }
  @media (max-width: 420px) { .lib { display: none; } }
</style>
<script>
  const NB = (window as any).NoBabysitting;
  document.querySelectorAll<HTMLElement>('[data-logo]').forEach((el) => { el.innerHTML = NB.logoSVG('sm'); el.firstElementChild!.classList.add('is-mono'); });

  /* motion: the choice is stored and the page reloads, so every scene starts in the chosen mode */
  document.querySelectorAll<HTMLButtonElement>('[data-motion]').forEach((b) => {
    let local: string | null = null; try { local = localStorage.getItem('nb-motion'); } catch (e) { /* storage blocked */ }
    const os = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const on = !os && local !== 'off';
    b.setAttribute('aria-pressed', String(on));
    b.title = on ? 'Tắt chuyển động của trang' : 'Bật chuyển động của trang';
    if (os) { b.disabled = true; b.title = 'Đang theo cài đặt giảm chuyển động của hệ thống'; return; }
    b.addEventListener('click', () => {
      try { if (on) localStorage.setItem('nb-motion', 'off'); else localStorage.removeItem('nb-motion'); } catch (e) { return; }
      location.reload();
    });
  });

  /* menu */
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]'), menu = document.getElementById('nb-menu');
  if (btn && menu) {
    const cv = menu.querySelector<HTMLCanvasElement>('.mcv')!, w = window as any;
    const rest = () => [...document.querySelectorAll<HTMLElement>('main, body > footer, .skip')];
    let A: any = null, tween: any = null, isOpen = false;
    const art = () => {
      if (A || !NB) return;
      const L = JSON.parse(menu.dataset.art!), small = innerWidth < 720;
      A = NB.ascii(cv, {
        cell: small ? [6, 10] : [7, 12], font: small ? '600 8.5px "JetBrains Mono", monospace' : '600 10px "JetBrains Mono", monospace',
        ramp: ' .:-=+*#%@', order: 0, sweep: 0.7, noiseFill: 0.3, noiseAlpha: 0.45, pointer: false, tone: 'fg-muted', frontColor: 'accent',
        source: NB.sources.bitmap(L, small ? { fill: 0.96, vfill: 0.7, cy: 0.52 } : { fill: 0.62, vfill: 0.84, cy: 0.5 }),
      });
    };
    const set = (open: boolean) => {
      isOpen = open;
      btn.setAttribute('aria-expanded', String(open)); btn.title = open ? 'Đóng menu' : 'Mở menu';
      document.documentElement.classList.toggle('nb-menu-open', open);
      rest().forEach((e) => { e.inert = open; });
      if (w.lenis) open ? w.lenis.stop() : w.lenis.start();
    };
    const open = () => {
      if (isOpen) return;
      set(true); menu.hidden = false; art();
      const items = menu.querySelectorAll('.m-main a, .m-h, .m-ch li, .m-foot'), g = w.gsap;
      if (A) { A.relayout(); A.state.order = 0; A.redraw(); }
      if (tween) tween.kill();
      if (g && A && !NB.reduce()) {
        tween = g.timeline().to(A.state, { order: 1, noiseFill: 0.08, duration: 1.1, ease: 'power1.inOut', onUpdate: A.redraw }, 0)
          .fromTo(items, { opacity: 0, x: -14 }, { opacity: 1, x: 0, duration: 0.4, stagger: 0.03, ease: 'power2.out', clearProps: 'transform' }, 0.2);
      } else { if (A) { A.state.order = 1; A.state.noiseFill = 0.08; A.redraw(); } }
      (menu.querySelector('a') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    const close = (focusBack = true) => {
      if (!isOpen) return;
      set(false);
      const done = () => { menu.hidden = true; };
      if (tween) tween.kill();
      if (w.gsap && A && !NB.reduce()) {
        tween = w.gsap.timeline({ onComplete: done })
          .to(menu.querySelectorAll('.m-main a, .m-h, .m-ch li, .m-foot'), { opacity: 0, duration: 0.18, stagger: 0.008 }, 0)
          .to(A.state, { order: 0, noiseFill: 0.3, duration: 0.7, ease: 'power1.in', onUpdate: A.redraw }, 0);
      } else done();
      if (focusBack) btn.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => (isOpen ? close() : open()));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    menu.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest('a'); if (a && a.pathname === location.pathname) { e.preventDefault(); close(false); } });
  }
</script>
