---
/* Điều hướng cuối trang cho lộ trình chính: phần trước, phần sau, và hàng mục lục 5 phần + Thực hành.
   Nút sang phần sau mang dải quét (data-sweep), dấu phần hiện tại nháy khi chuyển động bật: giống ChapterNav cũ. */
import { PARTS } from '../content/parts';
import { url } from '../lib/url';
const { current } = Astro.props as { current: string };
const ITEMS = [...PARTS.map((p) => ({ id: p.id, no: p.id, en: p.en, vi: p.vi, href: url(p.id + '/') })),
  { id: 'thuc-hanh', no: '→', en: 'PRACTICE', vi: 'Thực hành: ba bài tự làm', href: url('thuc-hanh/') }];
const i = ITEMS.findIndex((x) => x.id === current), prev = ITEMS[i - 1], next = ITEMS[i + 1];
---
<nav class="cn" aria-label="Mục lục lộ trình chính">
  <div class="pn">
    {prev ? <a class="nb-btn" href={prev.href}>← {prev.no} · {prev.vi}</a> : <a class="nb-btn" href={url()}>← Trang chủ</a>}
    {next ? <a class="nb-btn is-solid nx" data-sweep href={next.href}>{next.no === '→' ? '' : next.no + ' · '}{next.vi} →</a> : <a class="nb-btn is-solid nx" data-sweep href={url()}>Về trang chủ →</a>}
  </div>
  <ol class="rail">
    {ITEMS.map((c, k) => (
      <li><a href={c.href} aria-current={k === i ? 'step' : undefined} class={k < i ? 'past' : ''}>
        <span class="g" aria-hidden="true">{k < i ? '✓' : k === i ? '■' : '·'}</span><span class="no">{c.no}</span><span class="en" lang="en">{c.en}</span><span class="vi">{c.vi}</span>
      </a></li>
    ))}
  </ol>
</nav>
<style>
  .cn { display: grid; gap: 24px; border-top: 1px solid var(--control); padding-top: 24px; }
  .pn { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pn :global(.nb-btn) { min-height: 48px; }
  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); border-top: 1px solid var(--line); }
  .rail a { position: relative; display: grid; grid-template-columns: 2ch 3ch 1fr; gap: 2px 10px; padding: 10px 8px; min-height: 44px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--fg-muted); }
  .rail a:hover { background: var(--bg-raised); }
  .rail a[aria-current='step'] { color: var(--fg); background: var(--bg-raised); }
  .rail a[aria-current='step']::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent); }
  .rail a[aria-current='step'] .g { color: var(--accent); }
  :global(html.motion) .rail a[aria-current='step']::before, :global(html.motion) .rail a[aria-current='step'] .g { animation: nb-blink 1.1s steps(1, end) infinite; }
  .g, .no { font: 600 13px/1.4 var(--font-mono); }
  .en { font: 600 13px/1.4 var(--font-mono); letter-spacing: .06em; }
  .vi { grid-column: 3; font-size: 14px; }
</style>
