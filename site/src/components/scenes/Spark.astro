---
import { url } from '../../lib/url';
/* Scene · Spark (right after the hero). Two hands from the owner's image of Michelangelo's "The Creation of Adam"
   (fresco, public domain; see THIRD_PARTY_NOTICES.md) drawn as ASCII by a small renderer of their own. Scrolling
   closes the gap (pinned, scrubbed), but the two fingers never touch (owner, 11/11: in the fresco man does not reach
   God in the flesh; the gap is the point). A spark gathers in the gap, then the hands come apart slowly into far fewer
   glyphs than made them, carried outward by an orange wave of glyphs that thins into the dark as the stage scrolls away.
   Every frame is a pure function of the scroll position, so it scrubs forward and back; motion.ts (nbAuto) plays it by
   itself when the visitor stops scrolling. The picture emerges glyph by glyph as the hero leaves, and every screen gets
   about 150 columns, so a phone sees it as finely as a desktop.
   Reduced motion / motion off: one still frame, fingertips almost touching, no pin. Idle cost: nothing is painted
   unless the scroll position changes. */
---
<section class="spark" id="spark" aria-label="Hai bàn tay">
  <div class="stage" id="spark-stage" data-fresco={url('art/fresco.jpg')} data-left={url('art/hand-left.png')} data-right={url('art/hand-right.png')}>
    <canvas class="cv" id="spark-cv" aria-hidden="true"></canvas>
    <p class="nb-sr">Hình ASCII: toàn cảnh bức tranh theo bích hoạ “Sáng tạo ra Adam” của Michelangelo, rồi cận cảnh hai bàn tay vươn tới nhau. Hai ngón tay tiến lại gần nhưng không chạm nhau; một tia sáng loé lên ở khe hở, rồi hình tan thành một làn sóng ký tự màu cam và chìm dần vào nền tối.</p>
  </div>
</section>

<style>
  .spark { position: relative; background: var(--bg); }
  .stage { position: relative; height: calc(100svh - var(--hud-height)); min-height: 480px; overflow: hidden; background: var(--bg); }
  .cv { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* cinema: the header fades out as the hands meet and comes back with the next words; it always returns on keyboard focus */
  :global(.hud.nb-cinema-fade:focus-within) { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
</style>

<script>
  const CH = ' .:-=+*#%@';
  const hash = (x: number, y: number) => { let h = (x * 374761393 + y * 668265263) | 0; h = Math.imul(h ^ (h >>> 13), 1274126177); return ((h ^ (h >>> 16)) >>> 0) / 4294967295; };
  const load = (src: string) => new Promise<HTMLImageElement>((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src; });
  type Cell = { x: number; y: number; c: string; r: number; g: number; b: number; a: number };

  async function spark(canvas: HTMLCanvasElement, frescoSrc: string, leftSrc: string, rightSrc: string) {
    const [F, L, R] = await Promise.all([load(frescoSrc), load(leftSrc), load(rightSrc)]);
    const g = canvas.getContext('2d')!, off = document.createElement('canvas'), og = off.getContext('2d', { willReadFrequently: true })!;
    const css = getComputedStyle(document.documentElement), tok = (n: string, f: string) => css.getPropertyValue(n).trim() || f;
    const BG = tok('--bg', '#14120f');
    let W = 0, H = 0, cw = 8, ch = 14, cols = 0, rows = 0, lay = { w: 0, h: 0, x: 0, y: 0, s: 1 }, gap = 0.3, zoom = 0, mix = 0, appear = 1, glow = 0;
    let glyphs: Cell[] = [], wv = -1, final: Cell[] | null = null;
    const tip = () => ({ x: W / 2, y: lay.y + lay.h * 0.4 });
    function size() {
      const r = canvas.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1); W = r.width; H = r.height;
      const small = W < 640;
      /* same glyph density on every screen: about 150 columns across, so a phone sees the picture as finely as a desktop */
      cw = Math.max(3.6, Math.min(8, W / 150)); ch = cw * 1.75;
      cols = Math.ceil(W / cw); rows = Math.ceil(H / ch); off.width = cols; off.height = rows;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.font = `500 ${(cw * 1.5).toFixed(2)}px "JetBrains Mono", ui-monospace, monospace`; g.textBaseline = 'top';
      const lw = small ? W * 2.2 : Math.min(W * 1.1, H * 1.7 * 199 / 109), lh = lw * 109 / 199;
      lay = { w: lw, h: lh, x: (W - lw) / 2, y: H / 2 - lh * 0.4, s: lw / 199 }; final = null;   // fingertips (40% down the image) on the middle line
    }
    const smooth = (t: number) => t * t * (3 - 2 * t);
    function tone(r: number, gg: number, b: number, a: number, x: number, y: number): Cell {
      let l = (0.299 * r + 0.587 * gg + 0.114 * b) / 255; l = Math.pow(Math.max(0, (l - 0.1) / 0.9), 1 / 1.35);
      const m = (r + gg + b) / 3;
      r = Math.min(255, (m + (r - m) * 1.45) * 1.35); gg = Math.min(255, (m + (gg - m) * 1.45) * 1.35); b = Math.min(255, (m + (b - m) * 1.45) * 1.35);
      const k = Math.max(1, Math.min(CH.length - 1, Math.round((0.25 + 0.75 * l) * a * (CH.length - 1))));
      return { x, y, c: CH[k], r, g: gg, b, a: Math.min(1, 0.45 + 0.6 * a) };
    }
    /* the whole fresco (owner's first image), zoomed toward the fingertips as you scroll */
    function frescoData() {
      /* starts with the whole picture in view (contain), so a phone sees all of it before the zoom */
      const fw = Math.min(W, H * 1000 / 545), z = 1 + (W < 640 ? 4.8 : 4.4) * smooth(zoom), w = fw * z, h = w * 545 / 1000;
      const fx = 0.44, fy = 0.5, k = smooth(zoom);                          // fingertips in the fresco
      const cx = W / 2 - (fx - 0.5) * w * k, cy = H / 2 - (fy - 0.5) * h * k;
      og.setTransform(1, 0, 0, 1, 0, 0); og.clearRect(0, 0, cols, rows);
      og.setTransform(1 / cw, 0, 0, 1 / ch, 0, 0); og.imageSmoothingQuality = 'high';
      og.drawImage(F, cx - w / 2, cy - h / 2, w, h);
      return og.getImageData(0, 0, cols, rows).data;
    }
    /* the close-up hands (owner's second image), background removed; gap closes as you scroll */
    function handsData() {
      og.setTransform(1, 0, 0, 1, 0, 0); og.clearRect(0, 0, cols, rows);
      og.setTransform(1 / cw, 0, 0, 1 / ch, 0, 0); og.imageSmoothingQuality = 'high';
      /* at gap 0 the fingertips stop about two glyphs apart: they never meet */
      const travel = W * 0.42 * gap, touch = 1.7 * lay.s * (1 - gap / 0.3);
      og.drawImage(L, lay.x - travel + touch, lay.y, 98 * lay.s, lay.h);
      og.drawImage(R, lay.x + 98 * lay.s + travel - touch, lay.y, 101 * lay.s, lay.h);
      return og.getImageData(0, 0, cols, rows).data;
    }
    function cells(): Cell[] {
      const hd = mix > 0 ? handsData() : null, fd = mix < 1 ? frescoData() : null, out: Cell[] = [];
      for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
        if (appear < 1 && hash(y, x) > appear) continue;                          // the picture emerges glyph by glyph as the hero scrolls away
        const o = (y * cols + x) * 4, useH = !fd || (hd && hash(x, y) < mix);   // glyph-by-glyph dissolve from fresco to hands
        if (useH) {
          const d = hd!, a = d[o + 3] / 255;
          if (a < 0.1) { if (hash(x, y) > 0.986) out.push({ x, y, c: '.', r: 74, g: 69, b: 62, a: 0.6 }); continue; }
          out.push(tone(d[o] / a, d[o + 1] / a, d[o + 2] / a, a, x, y));
        } else {
          const d = fd!, a = d[o + 3] / 255; if (a < 0.1) continue;
          const r = d[o], gg = d[o + 1], bb = d[o + 2], mx = Math.max(r, gg, bb), sat = mx ? (mx - Math.min(r, gg, bb)) / mx : 0;
          const lum = (0.299 * r + 0.587 * gg + 0.114 * bb) / 255, glare = smooth(Math.max(0, Math.min(1, (lum - 0.78) / 0.2)));
          const wall = Math.max(1 - smooth(Math.max(0, Math.min(1, (sat - 0.1) / 0.22))), 0.75 * glare);   // pale plaster and the painted glare recede, the figures stay
          if (wall > 0.6 && hash(x, y) > 0.55) continue;
          const q = tone(r, gg, bb, 1 - 0.55 * wall, x, y); q.a *= 1 - 0.7 * wall; out.push(q);
        }
      }
      return out;
    }
    /* paint a list of cells on the grid, grouped by quantised colour so the canvas changes state rarely */
    function paint(list: Cell[]) {
      g.globalAlpha = 1; g.fillStyle = BG; g.fillRect(0, 0, W, H);
      const groups = new Map<string, Cell[]>();
      for (const q of list) {
        const k = `${(q.r >> 4) << 4},${(q.g >> 4) << 4},${(q.b >> 4) << 4}|${Math.round(q.a * 4) / 4}`;
        let arr = groups.get(k); if (!arr) groups.set(k, arr = []); arr.push(q);
      }
      for (const [k, arr] of groups) {
        const [rgb, al] = k.split('|'); g.fillStyle = `rgb(${rgb})`; g.globalAlpha = +al;
        for (const q of arr) g.fillText(q.c, q.x * cw, q.y * ch);
      }
      g.globalAlpha = 1;
    }
    /* light made of glyphs on the same grid (no gradients, no strokes): a small core, thin rays and, in the burst, a
       ring, like the painted sunburst of the reference rendered as ASCII. Every lit cell is dithered, so the light reads
       as a field of glyphs and never as a flat block. Cells it reaches take brighter glyphs and warmer colours. */
    const RAYS = 26, TAU = Math.PI * 2;
    const rayAng = Array.from({ length: RAYS }, (_, i) => (i + (hash(i, 11) - 0.5) * 0.7) / RAYS * TAU);
    const rayLen = Array.from({ length: RAYS }, (_, i) => 0.35 + 0.65 * hash(i, 5) * hash(i, 9));
    const rayDir = rayAng.map(a => { const d = ((a * 180 / Math.PI) % 180 + 180) % 180; return d < 22.5 || d >= 157.5 ? '-' : d < 67.5 ? '\\' : d < 112.5 ? '|' : '/'; });
    function light(base: Cell[], cx: number, cy: number, Rr: number, k: number, Rc: number, ring = 0): Cell[] {
      if (k <= 0 || Rr <= 0) return base;
      const map = new Map<number, Cell>(); for (const q of base) map.set(q.y * cols + q.x, q);
      const x0 = Math.max(0, Math.floor((cx - Rr) / cw)), x1 = Math.min(cols - 1, Math.ceil((cx + Rr) / cw));
      const y0 = Math.max(0, Math.floor((cy - Rr) / ch)), y1 = Math.min(rows - 1, Math.ceil((cy + Rr) / ch));
      const rw = Math.max(cw * 1.2, 2.2 * cw * Rc / (Math.max(W, H) * 0.06)), shell = cw * 2.5;
      for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
        const dx = x * cw + cw / 2 - cx, dy = (y * ch + ch / 2 - cy) / 0.85, d = Math.hypot(dx, dy);
        if (d > Rr) continue;
        const n = hash(x * 13 + 7, y * 17 + 3);                                   // per-cell dither
        const core = Math.exp(-Math.pow(d / Rc, 2));
        let ray = 0, dirc = '|';
        let an = Math.atan2(dy, dx); if (an < 0) an += TAU;
        for (let i = 0; i < RAYS; i++) {
          let da = Math.abs(an - rayAng[i]); if (da > Math.PI) da = TAU - da;
          const off = da * d, len = Rr * rayLen[i];
          if (off < rw && d < len) {
            const dash = 0.45 + 0.55 * hash(i, Math.floor(d / (ch * 1.6)));      // rays are broken into dashes, like strokes
            const v = (1 - off / rw) * Math.pow(1 - d / len, 0.7) * dash;
            if (v > ray) { ray = v; dirc = rayDir[i]; }
          }
        }
        const rg = ring > 0 ? Math.exp(-Math.pow((d - ring) / shell, 2)) * (0.35 + 0.65 * n) * (1 - 0.6 * ring / Rr) : 0;
        const I = Math.min(1, (0.95 * core + 0.8 * ray + 0.7 * rg) * k) * (0.72 + 0.28 * n);
        if (I < 0.06 || (I < 0.22 && n > 0.75)) continue;
        const prev = map.get(y * cols + x);
        if (prev && prev.a * 0.55 > I) continue;
        const idx = Math.max(1, Math.min(CH.length - 1, Math.round(I * (CH.length - 1) + (n - 0.5) * 2.2)));
        const c = ray > core && ray > rg && I < 0.7 ? dirc : CH[idx];
        const r = 230 + 25 * I, gg = 140 + 105 * I, b = 70 + 140 * I * I;          // ember → gold → near white
        map.set(y * cols + x, { x, y, c, r, g: gg, b, a: Math.min(1, 0.3 + 0.8 * I) });
      }
      return Array.from(map.values());
    }
    function draw() {
      glyphs = cells();
      /* a small light gathers in the gap as the fingers near each other; while they wait (glow 0..1) it swells and breathes */
      if (gap < 0.2 && mix >= 1) { const t = tip(), k = 1 - gap / 0.2, M = Math.max(W, H), b = glow * (0.75 + 0.25 * Math.sin(glow * 9));
        paint(light(glyphs, t.x, t.y, M * (0.03 + 0.05 * k + 0.12 * b), 0.3 + 0.4 * k + 0.3 * b, M * (0.006 + 0.01 * k + 0.014 * b))); }
      else paint(glyphs);
    }
    /* the coming apart, d = 0..1. Three layers on the one grid:
       - the hands fade where they are, warming toward orange;
       - about a quarter of their glyphs drift outward on eased, slightly curved paths (fewer glyphs than drew the hands);
       - a wave of glyphs runs out from the gap: a bright front, a rippling field behind it, in a gradient from pale gold
         at the centre through the accent orange to a deep ember at the edge. From d = 0.55 everything thins into the dark. */
    const ORANGE = [[255, 208, 138], [236, 142, 82], [198, 90, 42], [118, 44, 20]];
    function orange(t: number): [number, number, number] {
      t = Math.max(0, Math.min(0.999, t)) * 3; const i = Math.floor(t), f = t - i, a = ORANGE[i], b = ORANGE[i + 1];
      return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
    }
    function wave(d: number) {
      if (!final) { const g0 = gap, m0 = mix, z0 = zoom, a0 = appear; gap = 0; mix = 1; zoom = 1; appear = 1; final = cells().filter(q => q.c !== '.'); gap = g0; mix = m0; zoom = z0; appear = a0; }
      const c = tip(), M = Math.hypot(W, H) / 2, map = new Map<number, Cell>();
      const out = 1 - smooth(Math.max(0, Math.min(1, (d - 0.55) / 0.45))), e = 1 - Math.pow(1 - Math.min(1, d / 0.85), 3);
      const stay = Math.max(0, 1 - d / 0.3), warm = Math.min(1, d * 3.5), front = M * 1.15 * (1 - Math.pow(1 - d, 2.2));
      for (const q of final) {
        const h = hash(q.x * 3 + 1, q.y * 7 + 5), px = q.x * cw - c.x, py = (q.y * ch - c.y) / 0.85, dist = Math.hypot(px, py) + 1;
        if (h < 0.26) {
          const h2 = hash(q.y + 31, q.x + 17), r = dist + (0.15 + 0.85 * h2) * M * 0.75 * e, an = Math.atan2(py, px) + (h2 - 0.5) * 0.9 * e;
          const x = Math.round((c.x + Math.cos(an) * r) / cw), y = Math.round((c.y + Math.sin(an) * r * 0.85 - 26 * e * h) / ch);
          if (x < 0 || x >= cols || y < 0 || y >= rows) continue;
          const o = orange(r / (M * 1.6) + (h2 - 0.5) * 0.2);
          map.set(y * cols + x, { x, y, c: q.c, r: q.r + (o[0] - q.r) * warm, g: q.g + (o[1] - q.g) * warm, b: q.b + (o[2] - q.b) * warm, a: Math.min(1, q.a + 0.2) * out });
        } else if (stay > 0 && h < 0.26 + 0.74 * stay) {
          const o = orange(0.35);
          map.set(q.y * cols + q.x, { x: q.x, y: q.y, c: q.c, r: q.r + (o[0] - q.r) * warm, g: q.g + (o[1] - q.g) * warm, b: q.b + (o[2] - q.b) * warm, a: q.a * stay });
        }
      }
      const band = M * 0.1;
      for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
        const dx = x * cw + cw / 2 - c.x, dy = (y * ch + ch / 2 - c.y) / 0.85, dd = Math.hypot(dx, dy);
        if (dd > front + band * 2) continue;
        const n = hash(x * 13 + 7, y * 17 + 3);
        const edge = Math.exp(-Math.pow((dd - front) / band, 2));
        const ripple = 0.5 + 0.5 * Math.sin(dd / (ch * 2.4) - d * 16 + n * 1.6);
        const behind = dd < front ? 0.5 * Math.pow(dd / Math.max(1, front), 1.4) * ripple : 0;
        const I = Math.min(1, (1.1 * edge + behind) * (0.65 + 0.35 * n)) * out;
        if (I < 0.1 || (I < 0.3 && n > 0.55)) continue;
        const k = y * cols + x, prev = map.get(k); if (prev && prev.a > I) continue;
        const o = orange(dd / (M * 1.5) + (n - 0.5) * 0.14), idx = Math.max(1, Math.min(CH.length - 1, Math.round(I * (CH.length - 2) + n * 2)));
        map.set(k, { x, y, c: CH[idx], r: o[0], g: o[1], b: o[2], a: Math.min(1, 0.3 + 0.9 * I) });
      }
      /* the spark itself: a short flash in the gap at the start of the wave */
      const fl = Math.exp(-d / 0.07), list = Array.from(map.values());
      paint(fl > 0.03 ? light(list, c.x, c.y, M * (0.14 + 0.5 * d), fl, M * (0.02 + 0.05 * fl)) : list);
    }
    size(); draw();
    return {
      set(v: { zoom: number; mix: number; gap: number; glow?: number }) { wv = -1; zoom = v.zoom; mix = v.mix; gap = Math.max(0, Math.min(1, v.gap)); glow = v.glow || 0; draw(); },
      reveal(v: number) { appear = Math.max(0, Math.min(1, v)); if (wv < 0) draw(); },
      wave(d: number) { wv = Math.max(0, Math.min(1, d)); wave(wv); },
      resize() { size(); if (wv < 0) draw(); else wave(wv); },
    };
  }

  async function start(w: any) {
    const NB = w.NoBabysitting, gsap = w.gsap, ST = w.ScrollTrigger;
    const stage = document.getElementById('spark-stage')!, cv = document.getElementById('spark-cv') as HTMLCanvasElement;
    const S = await spark(cv, stage.dataset.fresco!, stage.dataset.left!, stage.dataset.right!);
    addEventListener('resize', () => S.resize());
    if ((NB && NB.reduce()) || !gsap || !ST) { S.set({ zoom: 1, mix: 1, gap: 0.02 }); return; }
    /* inside the pin: 0–0.34 zoom into the fresco · 0.28–0.42 glyphs dissolve into the close-up · 0.42–0.66 the hands
       near each other and stop short · 0.66–0.76 the spark gathers in the gap · 0.76–1 the first 70% of the wave.
       The last 30% of the wave (thinning into the dark) plays while the stage scrolls away under the next section. */
    const NEAR = 0.66, WAVE = 0.76, IN = 0.7, clamp = (v: number) => Math.max(0, Math.min(1, v));
    const hud = document.querySelector<HTMLElement>('.hud');
    /* the header steps back while the hands wait and the wave runs, and returns as the stage leaves; it always returns on keyboard focus */
    const cinema = (k: number) => {
      if (!hud) return;
      hud.classList.toggle('nb-cinema-fade', k > 0);
      hud.style.opacity = k > 0 ? String(1 - k) : '';
      hud.style.transform = k > 0 ? `translateY(${-100 * k}%)` : '';
      hud.style.pointerEvents = k > 0.5 ? 'none' : '';
    };
    /* entering: the picture emerges glyph by glyph while the hero scrolls away, so there is no empty dark band */
    S.reveal(0);
    ST.create({ trigger: '#spark', start: 'top bottom', end: 'top top+=48', scrub: 0.3, onUpdate: (s: any) => S.reveal(0.05 + 0.95 * s.progress), onLeave: () => S.reveal(1), onLeaveBack: () => S.reveal(0) });
    const pin = ST.create({
      trigger: '#spark', start: 'top top+=48', end: '+=130%', pin: true, scrub: 0.5,
      onLeaveBack: () => cinema(0),
      onUpdate: (s: any) => {
        const p = s.progress; cinema(clamp((p - 0.6) / 0.1));
        if (p >= WAVE) { S.wave(IN * (p - WAVE) / (1 - WAVE)); return; }
        S.set({ zoom: clamp(p / 0.34), mix: clamp((p - 0.28) / 0.14), gap: 0.3 * (1 - clamp((p - 0.42) / (NEAR - 0.42))), glow: clamp((p - NEAR) / (WAVE - NEAR)) });
      },
    });
    const tail = () => innerHeight * 0.5;
    ST.create({ trigger: '#spark', start: () => pin.end, end: () => pin.end + tail(), scrub: 0.3,
      onUpdate: (s: any) => { S.wave(IN + (1 - IN) * s.progress); cinema(1 - clamp((s.progress - 0.5) / 0.4)); }, onLeave: () => cinema(0) });
    /* played by itself: up to the pin, through it at the pace of the picture, on to the statement below and through its hold */
    const hold = () => (document.querySelector('#pyramid [data-hold]') as any)?.nbHold;
    w.nbAuto({ from: () => (w.nbIntroEnd ? w.nbIntroEnd() : 0) + 12, legs: [
      { to: () => pin.start, dur: 1.2 },
      { to: () => pin.start + (pin.end - pin.start) * NEAR, dur: 5.2 },
      { to: () => pin.start + (pin.end - pin.start) * WAVE, dur: 1.5 },
      { to: () => pin.end, dur: 2.6 },
      { to: () => (hold() ? hold().start : pin.end + tail()), dur: 2 },
      { to: () => (hold() ? hold().end : pin.end + tail()), dur: 3.4 },
    ] });
    ST.sort(); ST.refresh();
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
