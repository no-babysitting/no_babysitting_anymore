---
/* Scene · Bàn làm việc tự dựng lên (c01's big moment, PRD G1's six harness parts).
   Pinned. The Colleague sits in the middle; each part flies in from off-grid and snaps into place,
   the face changes with what it now has (M14), and the weekly report's four criteria tick (M9). */
const PARTS = [
  ['01', 'Context', 'c02', 'Hội thoại tập trung, rẻ hơn'],
  ['02', 'Kế hoạch', 'c03', 'Brief, plan, phỏng vấn'],
  ['03', 'Trí nhớ', 'c04', 'Hướng dẫn dự án gọn'],
  ['04', 'Khối xây dựng', 'c05', 'Skill, command, subagent'],
  ['05', 'Rào chắn', 'c06', 'Quyền, connector, hook'],
  ['06', 'Kiểm chứng', 'c07', 'Đối chiếu, reviewer độc lập'],
];
import { url } from '../../lib/url';
const CRIT = ['Hiểu đúng yêu cầu', 'Đúng chuẩn trình bày của team', 'Số liệu được kiểm chứng', 'Lặp lại được và tự chạy'];
---
<section class="hn" id="harness" aria-labelledby="harness-h">
  <div class="pin" id="harness-pin">
    <header class="hd">
      <span class="nb-micro"><span class="nb-sq"></span>Đồng nghiệp mới = model + harness</span>
      <h2 class="nb-wide" id="harness-h">Bàn làm việc tự dựng lên</h2>
    </header>
    <div class="desk">
      <div class="parts l">{PARTS.slice(0, 3).map((p) => <a class="part" href={url(`${p[2]}/`)}><span class="i">{p[0]}</span><b>{p[1]}</b><span class="d">{p[3]}</span><span class="c nb-micro">{p[2]}</span></a>)}</div>
      <div class="core">
        <span class="face" id="harness-face" aria-live="polite">[•_•]</span>
        <span class="nb-micro state" id="harness-state">đang chờ việc</span>
      </div>
      <div class="parts r">{PARTS.slice(3).map((p) => <a class="part" href={url(`${p[2]}/`)}><span class="i">{p[0]}</span><b>{p[1]}</b><span class="d">{p[3]}</span><span class="c nb-micro">{p[2]}</span></a>)}</div>
    </div>
    <footer class="report">
      <span class="nb-micro">Báo cáo tuần</span>
      <ol>{CRIT.map((c) => <li><span class="mk">[ ]</span>{c}</li>)}</ol>
      <p class="nb-cond cnt" aria-hidden="true"><span id="harness-cnt">0</span><small>/4</small></p>
    </footer>
  </div>
</section>

<style>
  .hn { position: relative; border-top: 1px solid var(--control); overflow-x: clip; }
  .pin { min-height: calc(100svh - var(--hud-height)); display: grid; grid-template-rows: auto 1fr auto; gap: 18px; padding-block: 28px 24px; }
  .hd { display: grid; gap: 10px; }
  .hd h2 { margin: 0; font-size: clamp(28px, 5vw, 64px); }
  .desk { display: grid; grid-template-columns: 1fr minmax(180px, .8fr) 1fr; gap: 14px; align-items: center; }
  .parts { display: grid; gap: 12px; }
  .part { display: grid; grid-template-columns: 3ch 1fr auto; gap: 2px 12px; padding: 14px 16px; border: 1px solid var(--control); background: var(--bg-raised); color: var(--fg); text-decoration: none; }
  .part:hover { border-color: var(--fg); }
  .part .i { grid-row: span 2; font: 600 12px/1.6 var(--font-mono); color: var(--fg-subtle); }
  .part b { font: 600 17px/1.3 var(--font-text); }
  .part .d { grid-column: 2; font-size: 13.5px; color: var(--fg-muted); }
  .part .c { grid-row: 1; grid-column: 3; }
  .core { display: grid; justify-items: center; gap: 12px; }
  .face { font: 600 clamp(44px, 7vw, 96px)/1 var(--font-mono); color: var(--fg-muted); white-space: nowrap; }
  .report { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; border-top: 1px solid var(--control); padding-top: 14px; }
  .report ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 14.5px; color: var(--fg-muted); }
  .report li.ok { color: var(--fg); } .report li.ok .mk { color: var(--signal); }
  .mk { font: 600 13px/1 var(--font-mono); margin-right: 6px; color: var(--fg-subtle); }
  .cnt { margin: 0; font-size: 64px; color: var(--fg); }
  .cnt small { font-size: .42em; color: var(--fg-subtle); }
  @media (max-width: 820px) {
    .pin { gap: 12px; padding-block: 16px 14px; }
    .hd h2 { font-size: 26px; }
    .face { font-size: 46px; }
    .report ol { font-size: 12.5px; gap: 3px 14px; }
    .cnt { font-size: 44px; }
    .part b { font-size: 15px; }
    .desk { grid-template-columns: 1fr 1fr; gap: 10px; }
    .parts { gap: 8px; }
    .core { grid-column: 1 / -1; grid-row: 1; }
    .part { padding: 10px 12px; } .part .d { display: none; }
    .report { grid-template-columns: 1fr auto; } .report > .nb-micro { display: none; }
  }
</style>

<script>
  function start(w: any) {
    const gsap = w.gsap, NB = w.NoBabysitting;
    const face = document.getElementById('harness-face')!, st = document.getElementById('harness-state')!;
    const col = NB.colleague(face, 'idle'), cnt = document.getElementById('harness-cnt')!;
    const parts = [...document.querySelectorAll<HTMLElement>('#harness .part')], crit = [...document.querySelectorAll<HTMLElement>('#harness .report li')];
    /* without motion the scene shows its end state: every part in place, the colleague verified, 4/4 */
    if (!gsap || NB.reduce()) {
      col.set('verified', true); st.textContent = 'đã kiểm chứng xong'; cnt.textContent = '4';
      crit.forEach((li) => { li.classList.add('ok'); li.querySelector('.mk')!.textContent = '[✓]'; });
      return;
    }
    const STATES: [number, string, string][] = [[0, 'idle', 'đang chờ việc'], [2, 'thinking', 'đang đọc, lập kế hoạch'], [4, 'working', 'đang làm việc'], [6, 'verified', 'đã kiểm chứng xong']];
    let lastP = -1, lastC = -1;
    function sync(p: number) {
      const shown = Math.floor(p * 7.2), ok = Math.min(4, Math.floor(Math.max(0, p - 0.55) / 0.42 * 4.4));
      if (shown !== lastP) { lastP = shown; const s = STATES.filter((x) => x[0] <= shown).pop()!; col.set(s[1]); st.textContent = s[2]; }
      if (ok !== lastC) {
        crit.forEach((li, i) => { const on = i < ok; if (on && !li.classList.contains('ok')) gsap.fromTo(li, { backgroundColor: 'rgba(140,192,132,.25)' }, { backgroundColor: 'rgba(0,0,0,0)', duration: 0.24 });
          li.classList.toggle('ok', on); li.querySelector('.mk')!.textContent = on ? '[✓]' : '[ ]'; });
        lastC = ok; cnt.textContent = String(ok);
      }
    }
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' },
      scrollTrigger: { trigger: '#harness', start: 'top top+=48', end: '+=200%', pin: '#harness-pin', scrub: 0.6, onUpdate: (s: any) => sync(s.progress) } });
    parts.forEach((p, i) => {
      const side = p.closest('.l') ? -1 : 1;
      const far = innerWidth < 820 ? 0.35 : 1;
      tl.fromTo(p, { x: side * (240 + 60 * (i % 3)) * far, y: (i % 3 - 1) * 90 * far, rotation: side * (6 + i * 2), autoAlpha: 0 },
        { x: 0, y: 0, rotation: 0, autoAlpha: 1, duration: 1, ease: 'nb-settle' }, i * 0.55);
    });
    tl.to({}, { duration: 2.2 });
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
