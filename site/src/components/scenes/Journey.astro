---
/* Scene · Hành trình. The 12 chapters as one horizontal track, pinned and scrubbed by vertical scroll.
   Each chapter number is ASCII art (NB.ascii + sources.text): noise as the panel enters, converging into the
   number by the centre of the screen (M11: white head, glyphs settle to accent), dissolving again as it leaves.
   The panel in the centre is the current one: full contrast and an accent rule; the others step back.
   Inside each panel the giant number drifts slower than the track (containerAnimation parallax);
   the level meter (Low → Pro) lights up as the track passes each part; the counter follows. */
import { chapters, href, PARTS } from '../../lib/chapters';
import { isLive } from '../../lib/status';
import { inline } from '../../lib/matrix';
const LV = ['LOW', 'MEDIUM', 'HIGH', 'PRO'];
const lvOf = (lv: string) => Math.max(0, LV.indexOf(lv.toUpperCase()));
---
<section class="journey" id="journey" aria-labelledby="journey-h">
  <div class="jpin" id="journey-pin">
    <div class="jhead wrap">
      <h2 class="nb-sr" id="journey-h">Hành trình {chapters.length} phần, từ vibe đến agentic</h2>
      <div class="meter" aria-hidden="true">
        {LV.map((l, i) => <span class={`lv l${i + 1}`}><i></i><b>{l}</b></span>)}
      </div>
      <span class="nb-micro cnt"><b id="journey-n">01</b> / {chapters.length} · <span id="journey-lv">LOW</span></span>
    </div>
    <div class="viewport">
      <ol class="track" id="journey-track">
        {chapters.map((c) => (
          <li class="panel" data-lv={c.id === 'c00' ? 0 : c.id === 'c10' ? 3 : lvOf(c.level)} data-no={c.no}>
            <a href={href(c.id)}>
              <canvas class="pcv" aria-hidden="true"></canvas>
              <span class="no nb-cond" aria-hidden="true">{c.no}</span>
              <span class="meta nb-micro">{PARTS[c.id]}{c.level && c.level !== 'Kết' ? ` · ${c.level.toUpperCase()}` : ''} · {c.minutes.split('/')[0].replace("'", ' phút')}{!isLive(c.id) && ' · đang viết'}</span>
              <span class="en nb-wide">{c.en}</span>
              <span class="vi">{c.vi}</span>
              <span class="q nb-q" set:html={inline(c.question)} />
              <span class="go nb-micro">{isLive(c.id) ? 'Vào chương →' : 'Xem khung chương →'}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey { position: relative; border-top: 1px solid var(--control); }
  .jpin { min-height: calc(100svh - var(--hud-height)); width: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); overflow-x: clip; padding-bottom: 28px; box-sizing: border-box; }
  .jhead { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 14px 12px; width: 100%; box-sizing: border-box; }
  .meter { display: flex; gap: 4px; }
  .lv { display: grid; gap: 5px; font: 600 12px/1 var(--font-mono); color: var(--fg-subtle); letter-spacing: .06em; }
  .lv i { display: block; width: 56px; height: 8px; border: 1px solid var(--control); }
  .lv.on { color: var(--fg); }
  .lv.on.l1 i { background: var(--level-1); border-color: var(--level-1); } .lv.on.l2 i { background: var(--level-2); border-color: var(--level-2); }
  .lv.on.l3 i { background: var(--level-3); border-color: var(--level-3); } .lv.on.l4 i { background: var(--level-4); border-color: var(--level-4); }
  .cnt b { font-variant-numeric: tabular-nums; }
  .viewport { position: relative; min-width: 0; overflow-x: clip; }
  .track { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .panel a { position: relative; display: grid; align-content: center; gap: 10px; padding: 26px 26px 30px; min-height: 100%; box-sizing: border-box; color: var(--fg); text-decoration: none; border-right: 1px solid var(--control); border-top: 1px solid var(--control); }
  .panel a:hover .go { color: var(--fg); }
  .no { font-size: clamp(120px, 20vh, 240px); line-height: .8; color: var(--fg); }
  .pcv { display: none; }
  :global(html.motion) .pcv { display: block; width: 100%; height: clamp(120px, 21svh, 210px); margin: 0 0 4px; transition: opacity .45s; }
  :global(html.motion) .panel:not(.is-active) .pcv { opacity: .4; }
  :global(html.motion) .no { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(html.motion) .panel a > :not(.pcv) { transition: opacity .45s, color .45s; }
  :global(html.motion) .panel:not(.is-active) a > :not(.pcv) { opacity: .32; }
  :global(html.motion) .panel a::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.22,1,.36,1); }
  :global(html.motion) .panel.is-active a::before { transform: scaleX(1); }
  .en { font-size: clamp(22px, 2.6vw, 36px); overflow-wrap: anywhere; } /* a long English word breaks instead of running into the next panel (WCAG 1.4.12) */
  .panel a > * { min-width: 0; }
  .vi { color: var(--fg-muted); font-size: 15px; }
  .q { font-size: clamp(19px, 1.7vw, 23px); line-height: 1.4; color: var(--fg); max-width: 26ch; margin-top: 8px; text-wrap: balance; }
  .go { margin-top: auto; padding-top: 10px; color: var(--fg-muted); display: inline-flex; align-items: center; min-height: 44px; }
  :global(html.motion) .track { display: flex; width: max-content; height: 100%; padding-left: max(16px, calc((100vw - var(--page-max)) / 2)); }
  :global(html.motion) .panel { width: min(46vw, 620px); flex: none; }
  :global(html.motion) .panel a { border-top: 0; height: 100%; }
  @media (max-width: 720px) {
    :global(html.motion) .panel { width: calc(100vw - 32px); }
    .panel a { padding: 22px 18px 26px; border-left: 0; }
    .meter .lv i { width: 30px; }
    .lv b { display: none; }
    .jhead { gap: 10px; }
  }
</style>

<script>
  function start(w: any) {
    const gsap = w.gsap;
    if (!gsap || w.NoBabysitting.reduce()) return;
    const track = document.getElementById('journey-track')!, n = document.getElementById('journey-n')!;
    const panels = gsap.utils.toArray<HTMLElement>('#journey .panel'), lvs = gsap.utils.toArray<HTMLElement>('#journey .lv');
    const small = innerWidth < 720;
    const dist = () => track.scrollWidth - innerWidth + (small ? 16 : 32);
    const move = gsap.to(track, {
      x: () => -dist(), ease: 'none',
      scrollTrigger: { trigger: '#journey', start: 'top top+=48', end: () => '+=' + dist(), pin: '#journey-pin', scrub: 0.8, invalidateOnRefresh: true,
        snap: { snapTo: 1 / (panels.length - 1), duration: { min: 0.2, max: 0.6 }, delay: 0.08, ease: 'power2.inOut' } },
    });
    const NB = w.NoBabysitting;
    panels.forEach((p, pi) => {
      /* the big number is made of many small characters (4x7 px cells on a phone) and starts at the panel's left edge */
      const A = NB.ascii(p.querySelector('canvas'), {
        cell: small ? [4, 7] : [5, 9], font: small ? '600 6.6px "JetBrains Mono", monospace' : '600 8.2px "JetBrains Mono", monospace',
        ramp: ' .:-=+*#%@', order: 0, sweep: 0.45, noiseFill: 0.25, pointer: false,
        tone: 'accent', frontColor: 'fg', fontLoad: '900 100px Archivo',
        source: NB.sources.text([p.dataset.no!], { family: '"Archivo", "Arial Black", sans-serif', weight: 900, stretch: 'ultra-condensed', fill: 0.7, vfill: 0.94, cy: 0.52, align: 'left', padX: 0 }),
      });
      const S = A.state;
      gsap.timeline({ scrollTrigger: { trigger: p, containerAnimation: move, start: 'left 95%', end: 'right 5%', scrub: true } })
        .fromTo(S, { order: 0, noiseFill: 0.45 }, { order: 1, noiseFill: 0.06, duration: 0.45, ease: 'none', onUpdate: A.redraw })
        .to(S, { duration: 0.15 })
        .to(S, { order: 0.6, noiseFill: 0.18, duration: 0.4, ease: 'none', onUpdate: A.redraw });
      gsap.from(p.querySelectorAll('.meta, .en, .vi, .q, .go'), { y: 24, stagger: 0.06, duration: 0.6,
        scrollTrigger: { trigger: p, containerAnimation: move, start: 'left 75%', toggleActions: 'play none none reverse' } });
      w.ScrollTrigger.create({ trigger: p, containerAnimation: move, start: 'left center', end: 'right center',
        onToggle: (s: any) => { if (!s.isActive) return;
          panels.forEach((x) => x.classList.toggle('is-active', x === p));
          n.textContent = String(pi + 1).padStart(2, '0'); const lv = +p.dataset.lv!;
          lvs.forEach((l, i) => l.classList.toggle('on', i <= lv)); document.getElementById('journey-lv')!.textContent = ['LOW', 'MEDIUM', 'HIGH', 'PRO'][lv]; } });
    });
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
