---
/* GENERATED by scripts/port-ds.py from design-system/components/ThenNowCard/preview.html. Edit the preview, then re-run. */

---
<div class="ds-ThenNowCard">
<section class="nb nb-frame tn" aria-label="Then → Now: quy tắc văn phong">
  <span class="nb-corner tl nb-micro"><span class="nb-sq"></span>SHIFT · Rule cứng → phán đoán</span>
  <span class="nb-corner tr nb-micro">c05 · <b>then → now</b></span>
  <div class="grid">
    <article class="card then" id="thennowcard-then">
      <span class="nb-ghost ghost" aria-hidden="true">Then</span>
      <span class="nb-micro">Hồi đó</span>
      <p class="txt"><span class="strike">“Không bao giờ viết đoạn văn quá 3 câu.”<span class="line" id="thennowcard-line" aria-hidden="true"></span></span></p>
      <p class="why">Rule cứng giúp model đời cũ tránh kịch bản xấu nhất.</p>
    </article>
    <div class="arrow" aria-hidden="true"><span id="thennowcard-arw">       </span></div>
    <article class="card now" id="thennowcard-now">
      <span class="nb-ghost ghost" aria-hidden="true">Now</span>
      <span class="nb-micro c-signal">Bây giờ</span>
      <p class="txt">“Viết giống văn phong các báo cáo đã duyệt.”</p>
      <p class="nb-q guide">Rule này chặn một rủi ro thật, hay đang mã hoá cứng một sở thích Claude tự suy ra được?</p>
      <span><span class="nb-tag is-warn">Phụ thuộc model</span></span>
    </article>
  </div>
  <div class="foot">
    <span class="nb-micro">Nguồn · Anthropic · six shifts</span>
    <button class="nb-btn" id="thennowcard-replay" type="button">Phát lại</button>
  </div>
</section>
</div>

<style is:global>.ds-ThenNowCard .tn{padding:50px 0 0}
.ds-ThenNowCard .grid{display:grid;grid-template-columns:1fr 92px 1fr;border-top:1px solid var(--control)}
.ds-ThenNowCard .card{position:relative;overflow:hidden;padding:22px 20px 22px;display:grid;gap:12px;align-content:start;min-height:250px}
.ds-ThenNowCard .card > *{position:relative;z-index:1}
.ds-ThenNowCard .card > .ghost{position:absolute;z-index:0;left:-2%;bottom:-14%;font-size:170px}
.ds-ThenNowCard .then{border-right:1px solid var(--control)}
.ds-ThenNowCard /* the old rule steps back in colour,.ds-ThenNowCard not opacity: fg-subtle keeps 4.7:1 on bg (WCAG 1.4.3) */
  .then.is-past > :not(.ghost){color:var(--fg-subtle);transition:color .24s}
.ds-ThenNowCard .now{border-left:1px solid var(--control);background:var(--bg-raised)}
.ds-ThenNowCard .txt{margin:0;font:600 clamp(17px,2vw,19px)/1.4 var(--font-text);color:var(--fg)}
.ds-ThenNowCard .strike{position:relative}
.ds-ThenNowCard .line{position:absolute;left:0;right:0;top:52%;height:2px;background:var(--danger);transform:scaleX(0);transform-origin:left}
.ds-ThenNowCard .why{margin:0;color:var(--fg-muted);line-height:1.5;font-size:14px}
.ds-ThenNowCard .guide{margin:0;font-size:19px;line-height:1.4;color:var(--fg);font-style:italic}
.ds-ThenNowCard .arrow{display:flex;align-items:center;justify-content:center;font:600 14px/1 var(--font-mono);color:var(--accent);letter-spacing:-.02em;white-space:pre}
.ds-ThenNowCard .arrow{color:var(--fg-muted)}
.ds-ThenNowCard .foot{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--control);padding:12px 14px}
@media (max-width:640px){.ds-ThenNowCard .grid{grid-template-columns:1fr}
.ds-ThenNowCard .arrow{padding:10px 0;border-top:1px solid var(--control);border-bottom:1px solid var(--control)}
.ds-ThenNowCard .then,.ds-ThenNowCard .now{border:0}}</style>

<script>
  function start(window: any) {
  var gsap = window.gsap, ScrambleTextPlugin = window.ScrambleTextPlugin, SplitText = window.SplitText, Flip = window.Flip, DrawSVGPlugin = window.DrawSVGPlugin, MorphSVGPlugin = window.MorphSVGPlugin, MotionPathPlugin = window.MotionPathPlugin, CustomEase = window.CustomEase;
  var NB = window.NoBabysitting;
  var arw = document.getElementById('thennowcard-arw'), FULL = '─────▶';
  if (!window.gsap || (NB && NB.reduce())) { document.getElementById('thennowcard-line').style.transform = 'scaleX(1)'; arw.textContent = FULL; document.getElementById('thennowcard-then').classList.add('is-past'); return; }
  gsap.registerPlugin(CustomEase);
  CustomEase.create('nb-settle', '0.22,1,0.36,1');
  var o = { n: 0 }, tl, then = document.getElementById('thennowcard-then'), card = document.querySelector('.tn');
  /* The old rule is shown first; the strike, the arrow and the new rule play when the card is first on screen (NB.seen), unhurried:
     about four seconds, so the order "this was the rule, this replaces it" can be read. "Phát lại" plays it again. */
  function prime() { gsap.set('#thennowcard-line', { scaleX: 0 }); gsap.set('#thennowcard-now', { opacity: 0, x: -24 }); arw.textContent = ''; then.classList.remove('is-past'); card.dataset.demo = 'idle'; }
  function play() {
    if (tl) tl.kill();
    prime(); o.n = 0; card.dataset.demo = 'playing';
    tl = gsap.timeline({ defaults: { ease: 'power3.out' }, onComplete: function () { card.dataset.demo = 'done'; } });
    tl.to('#thennowcard-line', { scaleX: 1, duration: 0.9, ease: 'power2.inOut' }, 1.0)
      .call(function () { then.classList.add('is-past'); }, null, 2.0)
      .to(o, { n: FULL.length, duration: 1.1, ease: 'steps(' + FULL.length + ')', onUpdate: function () { arw.textContent = FULL.slice(0, Math.round(o.n)); } }, 2.2)
      .to('#thennowcard-now', { x: 0, opacity: 1, duration: 1.1, ease: 'nb-settle' }, 3.5)
      .from('#thennowcard-now .ghost', { xPercent: -8, duration: 2, ease: 'power2.out' }, 3.5);
  }
  prime();
  NB.seen(document.querySelector('.tn'), play);
  document.getElementById('thennowcard-replay').addEventListener('click', play);
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
