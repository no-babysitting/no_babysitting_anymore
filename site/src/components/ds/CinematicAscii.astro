---
/* GENERATED by scripts/port-ds.py from design-system/components/CinematicAscii/preview.html. Edit the preview, then re-run. */

---
<div class="ds-CinematicAscii">
<section class="nb nb-frame cin" id="cinematicascii-cin" aria-label="Cảnh kết: hoàng hôn trên thành phố bằng ký tự">
  <canvas class="nb-canvas cv" id="cinematicascii-cv" aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>
  <span class="nb-corner tl nb-micro"><span class="nb-sq is-signal"></span>FINALE · FULL-COLOR</span>
  <span class="nb-corner tr nb-micro"><b>10</b> / 10</span>
  <div class="meta">
    <h2 class="nb-wide" id="cinematicascii-ct">No Babysitting</h2>
    <dl class="nb-micro">
      <div><dt>Người giao</dt><dd>Bạn</dd></div>
      <div><dt>Chế độ</dt><dd>AFK</dd></div>
      <div><dt>Lịch</dt><dd>Thứ Hai · 08:00</dd></div>
      <div><dt>Đã đối chiếu</dt><dd class="nb-tabular" id="cinematicascii-n">00 / 14</dd></div>
    </dl>
    <span class="nb-micro">Đồng nghiệp <span class="nb-mono face" id="cinematicascii-col">[>_<]≡</span></span>
  </div>
  <p class="nb-sr">Cảnh kết: một đường chân trời lúc hoàng hôn dựng bằng ký tự màu. Bạn đã rời bàn, việc vẫn tự chạy và tự kiểm chứng.</p>
</section>
</div>

<style is:global>.ds-CinematicAscii .cin{height:540px;cursor:crosshair}
.ds-CinematicAscii .cv{position:absolute;inset:0}
.ds-CinematicAscii .shade{position:absolute;left:0;right:0;bottom:0;height:46%;background:linear-gradient(to bottom,transparent,var(--bg) 88%);pointer-events:none;z-index:2}
.ds-CinematicAscii .meta{position:absolute;left:14px;right:14px;bottom:14px;z-index:3;display:grid;grid-template-columns:1fr auto;gap:10px 24px;align-items:end}
.ds-CinematicAscii .meta h2{margin:0;font-size:clamp(30px,6vw,60px);grid-column:1/-1}
.ds-CinematicAscii dl{display:flex;flex-wrap:wrap;gap:6px 26px;margin:0}
.ds-CinematicAscii dl div{display:grid;gap:2px}
.ds-CinematicAscii dt{color:var(--fg-subtle)}
.ds-CinematicAscii dd{margin:0;color:var(--fg)}
.ds-CinematicAscii .face{font-size:14px;letter-spacing:0}</style>

<script>
  function start(window: any) {
  var gsap = window.gsap, ScrambleTextPlugin = window.ScrambleTextPlugin, SplitText = window.SplitText, Flip = window.Flip, DrawSVGPlugin = window.DrawSVGPlugin, MorphSVGPlugin = window.MorphSVGPlugin, MotionPathPlugin = window.MotionPathPlugin, CustomEase = window.CustomEase;
  var NB = window.NoBabysitting; if (!NB) return;
  if (window.gsap && window.ScrambleTextPlugin) gsap.registerPlugin(ScrambleTextPlugin);
  var A = NB.ascii(document.getElementById('cinematicascii-cv'), {
    host: document.getElementById('cinematicascii-cin'), cell: [8, 14], mode: 'color', order: 0, sweep: 0.4, noiseFill: 0.35,
    font: '500 12px "JetBrains Mono", ui-monospace, monospace', lensColor: 'fg', lensPx: 120,
    source: NB.sources.scene({ sunX: 0.68 })
  });
  var col = NB.colleague(document.getElementById('cinematicascii-col'), 'working');
  var n = document.getElementById('cinematicascii-n'), cnt = { v: 0 };
  function pad(v) { return (v < 10 ? '0' : '') + v; }
  A.ready.then(function () {
    if (NB.reduce() || !window.gsap) { A.state.order = 1; A.redraw(); n.textContent = '14 / 14'; col.set('verified', true); return; }
    var tl = gsap.timeline({ delay: 0.3 });
    tl.to(A.state, { order: 1, duration: 3.4, ease: 'power2.inOut', onUpdate: A.redraw })
      .to(cnt, { v: 14, duration: 2.2, ease: 'none', snap: { v: 1 }, onUpdate: function () { n.textContent = pad(cnt.v) + ' / 14'; } }, 0.8)
      .call(function () { col.set('verified'); })
      .from('#cinematicascii-ct', { yPercent: 30, autoAlpha: 0, duration: 0.9, ease: 'power3.out' }, 0.2);
  });
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
