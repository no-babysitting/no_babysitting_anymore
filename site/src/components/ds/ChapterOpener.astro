---
/* GENERATED by scripts/port-ds.py from design-system/components/ChapterOpener/preview.html. Edit the preview, then re-run. */
const { id, no, en, vi, part, ghost, total = 12, pos = no, beats = 8, mins = '' } = Astro.props;
---
<div class="ds-ChapterOpener">
<section class="nb nb-frame op" id="chapteropener-op" aria-labelledby="chapteropener-t">
  <canvas class="nb-canvas cv" id="chapteropener-cv" aria-hidden="true"></canvas>
  <span class="nb-ghost gh" aria-hidden="true">{ghost}</span>
  <span class="nb-corner tl nb-micro" id="chapteropener-m1"><span class="nb-sq"></span>{part}</span>
  <span class="nb-corner tr nb-micro">{id} &nbsp;·&nbsp; <b id="chapteropener-clk" class="nb-tabular">--:--:--</b></span>
  <span class="nb-corner br nb-micro"><b>{pos}</b> / {total} &nbsp;·&nbsp; {beats} beat{mins && ` · ${mins}′`}</span>
  <p class="nb-cond idx" id="chapteropener-idx" aria-hidden="true">{no}</p>
  <div class="ttl">
    <p class="nb-micro"><span class="nb-sq"></span>{no === "00" ? "Mở đầu" : `Chương ${no}`}</p>
    <h1 class="nb-wide" id="chapteropener-t">{en}</h1>
    <div class="line" id="chapteropener-line"></div>
    <p class="sub">{vi}</p>
  </div>
</section>
</div>

<style is:global>.ds-ChapterOpener .op{height:500px}
.ds-ChapterOpener .cv{position:absolute;inset:0 0 40% 0;height:60%}
.ds-ChapterOpener .gh{right:-20px;top:40px;font-size:260px}
.ds-ChapterOpener .idx{position:absolute;left:-10px;bottom:-62px;margin:0;font-size:clamp(200px,34vw,330px);color:var(--fg)}
.ds-ChapterOpener .ttl{position:absolute;right:28px;bottom:58px;width:min(560px,58%);display:grid;gap:14px;z-index:3}
.ds-ChapterOpener .ttl h2{margin:0;font-size:clamp(30px,5vw,54px)}
.ds-ChapterOpener .sub{margin:0;font-size:17px;line-height:1.55;color:var(--fg-muted);max-width:44ch}
.ds-ChapterOpener .line{height:1px;background:var(--control);transform-origin:left center}
@media (max-width:640px){.ds-ChapterOpener .ttl{left:14px;right:14px;width:auto;bottom:120px}
.ds-ChapterOpener .idx{font-size:200px}}</style>

<script>
  function start(window: any) {
  var gsap = window.gsap, ScrambleTextPlugin = window.ScrambleTextPlugin, SplitText = window.SplitText, Flip = window.Flip, DrawSVGPlugin = window.DrawSVGPlugin, MorphSVGPlugin = window.MorphSVGPlugin, MotionPathPlugin = window.MotionPathPlugin, CustomEase = window.CustomEase;
  var NB = window.NoBabysitting; if (!NB) return;
  if (window.gsap && window.ScrambleTextPlugin) gsap.registerPlugin(ScrambleTextPlugin);
  NB.clock(document.getElementById('chapteropener-clk'));
  var A = NB.ascii(document.getElementById('chapteropener-cv'), {
    host: document.getElementById('chapteropener-op'), cell: [9, 16], order: 0.992, noiseFill: 0.3, ambient: true, flicker: 0.006,
    ramp: ' .·:/\\+*=#', tone: 'fg-muted', frontColor: 'fg-subtle', lensColor: 'accent', lensPx: 90,
    source: NB.sources.terrain({ scale: 0.075, threshold: 0.5, slope: -0.7, seed: 5 })
  });
  if (NB.reduce() || !window.gsap) return;
  var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('#chapteropener-idx', { yPercent: 35, autoAlpha: 0, duration: 1.0 })
    .from('#chapteropener-t', { y: 30, autoAlpha: 0, duration: 0.7 }, 0.25)
    .from('#chapteropener-line', { scaleX: 0, duration: 0.6, ease: 'power2.inOut' }, 0.45)
    .from('.sub', { y: 12, autoAlpha: 0, duration: 0.5 }, 0.6);
  var m1 = document.getElementById('chapteropener-m1'); NB.say(m1, m1.textContent);
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
