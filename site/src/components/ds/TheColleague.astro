---
/* GENERATED by scripts/port-ds.py from design-system/components/TheColleague/preview.html. Edit the preview, then re-run. */

---
<div class="ds-TheColleague">
<section class="nb nb-frame tc" aria-labelledby="thecolleague-tct">
  <div class="stage nb-dots" id="thecolleague-stage">
    <span class="nb-corner tl nb-micro" id="thecolleague-tct"><span class="nb-sq"></span>THE COLLEAGUE · M14</span>
    <span class="nb-corner tr nb-micro">state <b id="thecolleague-sn">idle</b> · <span id="thecolleague-tk">fg-muted</span></span>
    <span class="nb-ghost ghost" aria-hidden="true">Colleague</span>
    <span class="big" id="thecolleague-face" aria-live="polite">[•_•]</span>
    <span class="nb-micro when" id="thecolleague-when">Chờ việc · đưa con trỏ lại gần</span>
  </div>
  <div class="grid" role="group" aria-label="Trạng thái" id="thecolleague-grid"></div>
</section>
</div>

<style is:global>.ds-TheColleague .tc{display:grid;grid-template-rows:auto auto}
.ds-TheColleague .stage{position:relative;overflow:hidden;height:250px;display:grid;place-items:center;border-bottom:1px solid var(--control)}
.ds-TheColleague .big{font:600 clamp(64px,12vw,112px)/1 var(--font-mono);letter-spacing:-.02em;white-space:pre}
.ds-TheColleague .when{position:absolute;left:14px;bottom:12px;max-width:40ch}
.ds-TheColleague .ghost{right:-1%;bottom:-10%;font-size:200px}
.ds-TheColleague .grid{display:grid;grid-template-columns:repeat(7,1fr)}
.ds-TheColleague .cell{appearance:none;background:transparent;border:0;border-right:1px solid var(--control);border-radius:0;color:var(--fg);padding:14px 8px 12px;display:grid;gap:8px;justify-items:center;cursor:pointer;font:inherit}
.ds-TheColleague .cell:last-child{border-right:0}
.ds-TheColleague .cell .f{font:600 15px/1 var(--font-mono);letter-spacing:0;white-space:pre}
.ds-TheColleague .cell:hover{background:var(--bg-raised)}
.ds-TheColleague .cell[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
.ds-TheColleague .cell[aria-pressed="true"] .nb-micro,.ds-TheColleague .cell[aria-pressed="true"] .f{color:var(--bg)!important}
.ds-TheColleague .cell:focus-visible{outline:2px solid var(--focus-ring);outline-offset:-4px}
@media (max-width:640px){.ds-TheColleague .grid{grid-template-columns:repeat(4,1fr)}
.ds-TheColleague .cell{border-bottom:1px solid var(--control)}}</style>

<script>
  function start(window: any) {
  var gsap = window.gsap, ScrambleTextPlugin = window.ScrambleTextPlugin, SplitText = window.SplitText, Flip = window.Flip, DrawSVGPlugin = window.DrawSVGPlugin, MorphSVGPlugin = window.MorphSVGPlugin, MotionPathPlugin = window.MotionPathPlugin, CustomEase = window.CustomEase;
  var NB = window.NoBabysitting; if (!NB) return;
  if (window.gsap && window.ScrambleTextPlugin) gsap.registerPlugin(ScrambleTextPlugin);
  var WHEN = { idle: 'Chờ việc · đưa con trỏ lại gần', tracking: 'Con trỏ đến gần: mắt nhìn theo', thinking: 'Đang đọc hoặc lập kế hoạch', working: 'Nhật ký hành động đang chạy', asking: 'Xin quyền hoặc hỏi lại', overloaded: 'Context vượt ngưỡng', verified: 'Kiểm chứng xong' };
  var col = NB.colleague(document.getElementById('thecolleague-face'), 'idle'), grid = document.getElementById('thecolleague-grid'), btns = [];
  function pick(s) {
    col.set(s);
    document.getElementById('thecolleague-sn').textContent = s; document.getElementById('thecolleague-tk').textContent = NB.FACES[s][1];
    NB.say(document.getElementById('thecolleague-when'), WHEN[s]);
    btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.s === s)); });
  }
  Object.keys(NB.FACES).forEach(function (s) {
    var f = NB.FACES[s], b = document.createElement('button');
    b.type = 'button'; b.className = 'cell'; b.dataset.s = s; b.setAttribute('aria-pressed', String(s === 'idle'));
    b.innerHTML = '<span class="f" style="color:var(--' + f[1] + ')">' + f[0] + '</span><span class="nb-micro">' + s + '</span>';
    b.addEventListener('click', function () { pick(s); });
    grid.appendChild(b); btns.push(b);
  });
  var stage = document.getElementById('thecolleague-stage');
  stage.addEventListener('pointerenter', function () { if (col.get() === 'idle') pick('tracking'); });
  stage.addEventListener('pointerleave', function () { if (col.get() === 'tracking') pick('idle'); });
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
