---
/* GENERATED by scripts/port-ds.py from design-system/components/AgentWindow/preview.html. Edit the preview, then re-run. */

---
<div class="ds-AgentWindow">
<div class="tools" role="group" aria-label="Khung bề mặt">
  <button class="nb-btn" type="button" aria-pressed="true" data-chrome="app">App</button>
  <button class="nb-btn" type="button" aria-pressed="false" data-chrome="cli">CLI</button>
  <span class="sp"></span>
  <button class="nb-btn" type="button" id="agentwindow-replay">Phát lại</button>
</div>
<section class="nb nb-frame win" id="agentwindow-win" aria-label="Nhật ký agent">
  <span class="nb-corner tl nb-micro"><span class="nb-sq"></span><span class="app-only">bao-cao-tuan · Claude Code app</span><span class="cli-only">~/bao-cao-tuan $ claude</span></span>
  <span class="nb-corner tr nb-micro">state <b id="agentwindow-st">đang chạy</b><span class="face" id="agentwindow-col">[>_<]≡</span></span>
  <p class="you"><span class="nb-micro"><span class="app-only">Bạn</span><span class="cli-only c-accent">&gt;</span></span><span>Làm báo cáo thị trường tuần 45 theo đúng mẫu tuần trước.</span></p>
  <ol id="agentwindow-log">
    <li><span class="n">01</span><span class="ic">◇</span><span class="verb">Đọc</span><span class="obj">bao-cao-W44.html</span></li>
    <li><span class="n">02</span><span class="ic">◇</span><span class="verb">Đọc</span><span class="obj">ban-hang-T10.xlsx</span></li>
    <li><span class="n">03</span><span class="ic">◇</span><span class="verb">Tra web</span><span class="obj">giá cà phê robusta tuần này</span></li>
    <li class="ask"><span class="n">04</span><span class="ic">?</span><span class="verb">Xin quyền</span><span class="obj">sửa bao-cao-W45.md · <span class="stamp" id="agentwindow-stamp">[ chờ ]</span></span></li>
    <li class="check"><span class="n">05</span><span class="ic">✓</span><span class="verb">Kiểm</span><span class="obj">đối chiếu 14 số liệu với nguồn</span></li>
  </ol>
  <p class="res" id="agentwindow-res"><b>Kết quả</b>bao-cao-W45.md · 5 slide · tóm tắt chờ đăng Slack</p>
  <div class="input" aria-hidden="true"><span class="cli-only c-accent">&gt;</span><span class="p"><span class="app-only">Trả lời Claude…</span><span class="cli-only"><span class="blk"></span></span></span><span class="nb-micro app-only">[ gửi ]</span><span class="nb-micro cli-only">⏸ plan mode off · shift+tab</span></div>
</section>
</div>

<style is:global>.ds-AgentWindow .tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.ds-AgentWindow .tools .sp{flex:1}
.ds-AgentWindow .win{padding:44px 0 0;display:grid;grid-template-rows:auto 1fr auto}
.ds-AgentWindow .face{font:600 13px/1 var(--font-mono);letter-spacing:0;margin-left:8px}
.ds-AgentWindow .you{margin:0;padding:14px 18px;border-bottom:1px solid var(--control);display:grid;grid-template-columns:7ch 1fr;gap:12px;font-size:15px;line-height:1.5}
.ds-AgentWindow .you .nb-micro{padding-top:3px}
.ds-AgentWindow ol{list-style:none;margin:0;padding:8px 0;font:400 13.5px/1.45 var(--font-mono)}
.ds-AgentWindow ol li{display:grid;grid-template-columns:3ch 2ch 11ch 1fr;gap:10px;padding:6px 18px;align-items:baseline}
.ds-AgentWindow .n{color:var(--fg-subtle)}
.ds-AgentWindow .ic{color:var(--fg-muted)}
.ds-AgentWindow .verb{font-weight:600;letter-spacing:.04em;font-size:12.5px;color:var(--fg-muted)}
.ds-AgentWindow .obj{color:var(--fg);min-width:0;overflow-wrap:anywhere}
.ds-AgentWindow li.ask{background:var(--bg-raised);border-top:1px dashed var(--warn);border-bottom:1px dashed var(--warn)}
.ds-AgentWindow li.ask .ic,.ds-AgentWindow li.ask .verb{color:var(--warn)}
.ds-AgentWindow li.check .ic,.ds-AgentWindow li.check .verb{color:var(--signal)}
.ds-AgentWindow .stamp{color:var(--warn);font-weight:600;letter-spacing:.08em}
.ds-AgentWindow .res{margin:0 18px 12px;padding:10px 12px;border:1px solid var(--signal);font:500 13px/1.45 var(--font-mono);color:var(--fg)}
.ds-AgentWindow .res b{color:var(--signal);font-weight:600;letter-spacing:.04em;font-size:12.5px;margin-right:8px}
.ds-AgentWindow .input{display:flex;align-items:center;gap:12px;border-top:1px solid var(--control);padding:12px 18px;font:400 13.5px/1 var(--font-mono);color:var(--fg-subtle)}
.ds-AgentWindow .input .p{flex:1}
.ds-AgentWindow .blk{display:inline-block;width:.6em;height:1.1em;background:var(--accent);vertical-align:-2px}
.ds-AgentWindow .cli-only{display:none}
.ds-AgentWindow .win.cli .cli-only{display:inline}
.ds-AgentWindow .win.cli .app-only{display:none}
.ds-AgentWindow .win.cli ol li{grid-template-columns:3ch 2ch 11ch 1fr}
.ds-AgentWindow .win.cli .you{grid-template-columns:2ch 1fr}
@media (max-width:640px){.ds-AgentWindow ol li{grid-template-columns:2ch 10ch 1fr}
.ds-AgentWindow .n{display:none}}</style>

<script>
  function start(window: any) {
  var gsap = window.gsap, ScrambleTextPlugin = window.ScrambleTextPlugin, SplitText = window.SplitText, Flip = window.Flip, DrawSVGPlugin = window.DrawSVGPlugin, MorphSVGPlugin = window.MorphSVGPlugin, MotionPathPlugin = window.MotionPathPlugin, CustomEase = window.CustomEase;
  var NB = window.NoBabysitting; if (!NB) return;
  if (window.gsap && window.ScrambleTextPlugin) gsap.registerPlugin(ScrambleTextPlugin);
  var win = document.getElementById('agentwindow-win'), st = document.getElementById('agentwindow-st'), stamp = document.getElementById('agentwindow-stamp');
  var col = NB.colleague(document.getElementById('agentwindow-col'), 'working');
  document.querySelectorAll('[data-chrome]').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('[data-chrome]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      win.classList.toggle('cli', b.dataset.chrome === 'cli');
    });
  });
  function state(s, face) { st.textContent = s; col.set(face); }
  function done() { state('xong', 'verified'); stamp.textContent = '[ đã cho phép ]'; }
  if (!window.gsap || NB.reduce()) { done(); return; }
  var verbs = Array.prototype.map.call(document.querySelectorAll('.verb'), function (v) { return v.textContent; });
  var tl;
  function play() {
    if (tl) tl.kill();
    state('đang chạy', 'working'); stamp.textContent = '[ chờ ]';
    tl = gsap.timeline({ onComplete: done });
    tl.from('.you', { autoAlpha: 0, y: 6, duration: 0.3, ease: 'power3.out' });
    document.querySelectorAll('#agentwindow-log > li').forEach(function (li, i) {
      var at = 0.3 + i * 0.32 + (i > 3 ? 0.9 : 0);
      tl.from(li, { autoAlpha: 0, y: 6, duration: 0.3, ease: 'power3.out' }, at)
        .to(li.querySelector('.verb'), { duration: 0.45, scrambleText: { text: verbs[i], chars: NB.SCRAMBLE, speed: 0.6 } }, at);
      if (i === 3) tl.call(function () { state('chờ quyền', 'asking'); }, null, at + 0.2)
        .call(function () { NB.say(stamp, '[ đã cho phép ]'); state('đang chạy', 'working'); }, null, at + 1.0);
    });
    tl.from('#agentwindow-res', { autoAlpha: 0, y: 6, duration: 0.35, ease: 'power3.out' }, '+=0.15');
  }
  play();
  document.getElementById('agentwindow-replay').addEventListener('click', play);
  }
  if ((window as any).gsap) start(window); else document.addEventListener('nb:gsap', () => start(window), { once: true });
</script>
